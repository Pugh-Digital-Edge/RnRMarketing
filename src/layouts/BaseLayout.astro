---
import client from "@data/client.json";
import tracking from "@data/tracking.json";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import CustomChat from "@components/CustomChat.astro";
import "@styles/root.less";
import "@styles/dark.less";
import "@styles/refresh.less";

const { description, title, preloadedImage, preloadedImageMobile, dateModified, noindex = false, openGraphImage = '/assets/images/logo-small.jpg', bodyContract, conversionOnly = false, eagerAnalytics = false } = Astro.props;
// Keep one editorial freshness date for pages without frontmatter. Page-specific
// resource dates override this through the dateModified prop. This date reflects
// the site-wide AEO refresh completed on 2026-08-10.
const effectiveDateModified = dateModified ?? '2026-08-10';
const canonicalUrl = `https://${client.domain}${Astro.url.pathname}`;
const markdownUrl = `${canonicalUrl}index.md`;
const fullBrandSuffix = ` | ${client.name}`;
const shortBrandSuffix = ' | R&R Marketing';
const titleAlreadyNamesBrand = title.includes(client.name);
const titleAlreadyHasQualifier = title.includes('|');
const titleIsSelfContained = title.length >= 55;
const chosenTitleSuffix = titleAlreadyNamesBrand || titleAlreadyHasQualifier || titleIsSelfContained
    ? ''
    : `${title}${fullBrandSuffix}`.length <= 70 ? fullBrandSuffix : shortBrandSuffix;
const titleLimit = 70 - chosenTitleSuffix.length;
const shortenedTitle = title.length > titleLimit
    ? title.slice(0, titleLimit).replace(/\s+\S*$/, '').replace(/(?:\s+(?:and|for|with|the)|\s*&|[|,:;-]+)$/i, '').trim()
    : title;
const metadataTitle = `${shortenedTitle}${chosenTitleSuffix}`;
const descriptionSuffix = ' Explore SEO, PPC, web design, and lead tracking built specifically for restoration companies.';
const expandedDescription = description.length < 120
    ? `${description.trim().replace(/[.!?]?$/, '.')} ${descriptionSuffix}`
    : description.trim();
const metadataDescription = expandedDescription.length > 160
    ? `${expandedDescription.slice(0, 159).replace(/\s+\S*$/, '').replace(/[,:;-]+$/, '').trim()}.`
    : expandedDescription;
const routeKey = Astro.url.pathname === '/' ? 'home' : Astro.url.pathname.split('/').filter(Boolean)[0] ?? 'home';
const absoluteOpenGraphImage = openGraphImage.startsWith('http')
    ? openGraphImage
    : `https://${client.domain}${openGraphImage}`;

---
<!-- A fully fleshed-out <head>, dynamically changing based on client.json and the page front matter -->
<html lang="en" class={conversionOnly ? "conversion-page" : undefined}>
        <head>
            <!-- Standard meta tags -->
            <meta charset="UTF-8">
            <meta http-equiv="X-UA-Compatible" content="IE=edge">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <meta name="description" content={metadataDescription}>
            <meta name="author" content="Matt Pugh">
            {noindex && <meta name="robots" content="noindex, nofollow">}
            <link rel="canonical" href={canonicalUrl}>
            <link rel="alternate" type="text/markdown" href={markdownUrl} title={`${title} in Markdown`}>
            <link rel="alternate" type="text/plain" href="/llms.txt">
            <link rel="alternate" type="text/plain" href="/llms-full.txt">

            <!-- WebPage node ties each URL to the site + business entity and marks the
                 primary content region, giving AI crawlers a clear extraction target. -->
            <script type="application/ld+json" is:inline set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "WebPage",
                "@id": `https://${client.domain}${Astro.url.pathname}#webpage`,
                "url": `https://${client.domain}${Astro.url.pathname}`,
                "name": title,
                "alternativeHeadline": title,
                "description": metadataDescription,
                "inLanguage": "en-US",
                "dateModified": effectiveDateModified,
                "isPartOf": { "@id": "https://remediationrestorationmarketing.com/#website" },
                "about": { "@id": "https://remediationrestorationmarketing.com/#localbusiness" },
                "primaryImageOfPage": {
                    "@type": "ImageObject",
                    "url": "https://remediationrestorationmarketing.com/assets/images/logo-small.jpg"
                },
                "speakable": {
                    "@type": "SpeakableSpecification",
                    "cssSelector": ["h1", ".cs-title", ".cs-text"]
                }
            })} />


            <script type="application/ld+json" is:inline>
                {
                    "@context": "https://schema.org",
                    "@type": "LocalBusiness",
                    "name": "Remediation & Restoration Marketing",
                    "image": "https://remediationrestorationmarketing.com/assets/images/logo-small.jpg",
                    "@id": "https://remediationrestorationmarketing.com/#localbusiness",
                    "url": "https://remediationrestorationmarketing.com",
                    "telephone": "17174201766",
                    "email": "matt@remediationrestorationmarketing.com",
                    "priceRange": "$$",
                    "openingHours": "Mo-Fr 09:00-22:00",
                    "address": {
                        "@type": "PostalAddress",
                        "streetAddress": "1000 Carlisle St, STE 1625, Room 2",
                        "addressLocality": "Hanover",
                        "addressRegion": "PA",
                        "postalCode": "17331",
                        "addressCountry": "US"
                    },
                    "sameAs": [
                        "https://www.facebook.com/remediationrestorationmarketing",
                        "https://www.youtube.com/@RandR_Marketing",
                        "https://www.instagram.com/randr.marketing/",
                        "https://remediationrestorationmarketing.com"
                    ],
                    "founder": {
                        "@type": "Person",
                        "@id": "https://remediationrestorationmarketing.com/about/#matt-pugh",
                        "name": "Matt Pugh",
                        "jobTitle": "Founder and Restoration Marketing Specialist"
                    },
                    "geo": {
                        "@type": "GeoCoordinates",
                        "latitude": 39.8172159,
                        "longitude": -76.99499730000001
                    },
                    "openingHoursSpecification": {
                        "@type": "OpeningHoursSpecification",
                        "dayOfWeek": [
                            "Monday",
                            "Tuesday",
                            "Wednesday",
                            "Thursday",
                            "Friday"
                        ],
                        "opens": "09:00",
                        "closes": "22:00"
                    }
                }
            </script>

                <script type="application/ld+json" is:inline>
                {
                    "@context": "https://schema.org",
                    "@type": "Organization",
                    "name": "Remediation & Restoration Marketing",
                    "url": "https://remediationrestorationmarketing.com",
                    "logo": "https://remediationrestorationmarketing.com/assets/images/logo-small.jpg",
                    "image": "https://remediationrestorationmarketing.com/assets/images/logo-small.jpg",
                    "description": "Specialized marketing agency helping restoration companies generate more emergency service leads through SEO, PPC, web design, and digital marketing.",
                    "contactPoint": {
                    "@type": "ContactPoint",
                    "telephone": "+1-717-420-1766",
                    "email": "matt@remediationrestorationmarketing.com",
                    "contactType": "sales",
                    "areaServed": "US",
                    "availableLanguage": "English"
                    },
                    "sameAs": [
                    "https://www.facebook.com/remediationrestorationmarketing",
                    "https://www.youtube.com/@RandR_Marketing",
                    "https://www.instagram.com/randr.marketing/"
                    ],
                    "areaServed": {
                    "@type": "Country",
                    "name": "United States"
                    },
                    "brand": {
                    "@type": "Brand",
                    "name": "Remediation & Restoration Marketing",
                    "slogan": "Marketing Solutions for Restoration Companies"
                    },
                    "knowsAbout": [
                    "Water Damage Restoration Marketing",
                    "Fire Damage Restoration Marketing",
                    "Mold Remediation Marketing",
                    "Commercial Restoration Marketing",
                    "Sewage Cleanup Marketing",
                    "Biohazard Cleanup Restoration Marketing",
                    "Roof Damage Restoration Marketing"
                    ],
                    "foundingDate": "2024",
                    "founder": {
                        "@type": "Person",
                        "@id": "https://remediationrestorationmarketing.com/about/#matt-pugh",
                        "name": "Matt Pugh",
                        "url": "https://remediationrestorationmarketing.com/about/#matt-pugh",
                        "jobTitle": "Founder and Restoration Marketing Specialist"
                    }
                }
                </script>
                <script type="application/ld+json" is:inline set:html={JSON.stringify({
                    "@context": "https://schema.org",
                    "@type": "Person",
                    "@id": "https://remediationrestorationmarketing.com/about/#matt-pugh",
                    "name": "Matt Pugh",
                    "url": "https://remediationrestorationmarketing.com/about/",
                    "jobTitle": "Founder and Restoration Marketing Specialist",
                    "knowsAbout": [
                        "Restoration Marketing",
                        "Search Engine Optimization",
                        "Pay Per Click Advertising",
                        "Lead Attribution",
                        "Conversion-focused Web Design"
                    ],
                    "worksFor": { "@id": "https://remediationrestorationmarketing.com/#localbusiness" }
                })} />
                <script type="application/ld+json" is:inline>
                {
                    "@context": "https://schema.org",
                    "@type": "WebSite",
                    "@id": "https://remediationrestorationmarketing.com/#website",
                    "url": "https://remediationrestorationmarketing.com",
                    "name": "Remediation & Restoration Marketing",
                    "description": "Specialized marketing agency helping restoration companies generate more emergency service leads through SEO, PPC, web design, and digital marketing.",
                    "publisher": {
                        "@id": "https://remediationrestorationmarketing.com/#localbusiness"
                    },
                    "potentialAction": {
                        "@type": "SearchAction",
                        "target": {
                            "@type": "EntryPoint",
                            "urlTemplate": "https://remediationrestorationmarketing.com/resources/?search={search_term_string}"
                        },
                        "query-input": "required name=search_term_string"
                    }
                }
                </script>
            <!-- Prioritize only the responsive hero asset needed for this viewport. -->
            {preloadedImageMobile && preloadedImage ? (
                <>
                    <link rel="preload" href={preloadedImageMobile.src} imagesrcset={preloadedImageMobile.srcSet} imagesizes={preloadedImageMobile.sizes ?? '100vw'} media="(max-width: 600px)" as="image" fetchpriority="high" />
                    <link rel="preload" href={preloadedImage.src} imagesrcset={preloadedImage.srcSet} imagesizes={preloadedImage.sizes ?? '100vw'} media="(min-width: 601px)" as="image" fetchpriority="high" />
                </>
            ) : preloadedImage ? (
                <link rel="preload" href={preloadedImage.src} imagesrcset={preloadedImage.srcSet} imagesizes={preloadedImage.sizes ?? '100vw'} as="image" fetchpriority="high" />
            ) : null}
            <link rel="preload" href="/assets/fonts/poppins-v21-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
            <link rel="preload" href="/assets/fonts/poppins-v21-latin-700.woff2" as="font" type="font/woff2" crossorigin />
            <meta name="google-site-verification" content="Uhclxmf6JyErwpzjc2QhHZuENaQhwtR-TNMMiQVTT6o" />
            <!--Social Media Display-->
            <meta property="og:title" content={metadataTitle} />
            <meta property="og:description" content={metadataDescription} />
            <meta property="og:type" content="website" />
            <meta property="og:url" content={`https://${client.domain}${Astro.url.pathname}`} />
            <meta property="og:image" content={absoluteOpenGraphImage} />
            <meta property="og:image:secure_url" content={absoluteOpenGraphImage} />
            <link rel=sitemap href=/sitemap-index.xml>

            <!--Favicons-->
            <link rel="icon" type="image/png" href="/assets/favicons/favicon-96x96.png" sizes="96x96" />
            <link rel="icon" type="image/svg+xml" href="/assets/favicons/favicon.svg" />
            <link rel="shortcut icon" href="/assets/favicons/favicon.ico" />
            <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/apple-touch-icon.png" />
            <link rel="manifest" href="/assets/favicons/site.webmanifest" />
            <meta name="msapplication-TileColor" content="#da532c">
            <meta name="theme-color" content="#071a42">
         
            <!--For home page, use service keywords for the title, including location for SEO.
            Other pages should just include the page name.
            
            EXAMPLE:
            Home page - House Painting Contractors | Painters and Co. | TestCity, WA
            About Page - About us | Painters and Co.
            -->
            <title>
                {metadataTitle}
            </title>

            <!-- Load the CMS identity client only for invite/recovery callback URLs. -->
            {Astro.url.pathname === "/" && <script is:inline>
                if (/(invite_token|recovery_token|confirmation_token|email_change_token)=/.test(window.location.hash)) {
                    const identityScript = document.createElement('script');
                    identityScript.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
                    identityScript.onload = () => window.netlifyIdentity?.on('init', (user) => {
                        if (!user) window.netlifyIdentity.on('login', () => { document.location.href = '/admin/'; });
                    });
                    document.head.append(identityScript);
                }
            </script>}

            <!-- Sitewide Scripts -->
            <script src="../assets/js/nav.js"></script>
            <script is:inline define:vars={{ trackingConfig: tracking, eagerAnalytics }}>
                window.rrTracking = trackingConfig;
                window.rrEagerAnalytics = eagerAnalytics;
                window.dataLayer = window.dataLayer || [];
                window.gtag = function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());

                gtag('config', trackingConfig.ga4Id);

                // The GT- Google tag is configured alongside the GA4 property rather than
                // replacing it, so measurement keeps working if the GT container's
                // destinations are ever changed in the Google tag UI.
                if (trackingConfig.googleTagId) {
                    gtag('config', trackingConfig.googleTagId);
                }

                // The Google Ads tag only configures when a real conversion ID is present,
                // so an unconfigured account never sends malformed hits.
                if (trackingConfig.googleAdsId) {
                    gtag('config', trackingConfig.googleAdsId, { allow_enhanced_conversions: true });
                }
            </script>
            <script is:inline>
                // Capture Google Ads click identifiers and campaign parameters once per session so
                // the lead form can submit them and offline conversion import stays possible.
                (() => {
                    const TRACKED_PARAMS = ['gclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
                    const STORAGE_KEY = 'rr_click_attribution';

                    const readStored = () => {
                        try {
                            return JSON.parse(window.sessionStorage.getItem(STORAGE_KEY)) || {};
                        } catch {
                            return {};
                        }
                    };

                    const params = new URLSearchParams(window.location.search);
                    const stored = readStored();
                    let changed = false;

                    TRACKED_PARAMS.forEach((key) => {
                        const value = params.get(key);
                        if (value && stored[key] !== value) {
                            stored[key] = value;
                            changed = true;
                        }
                    });

                    if (!stored.landing_page) {
                        stored.landing_page = window.location.pathname;
                        changed = true;
                    }

                    if (changed) {
                        try {
                            window.sessionStorage.setItem(STORAGE_KEY, JSON.stringify(stored));
                        } catch {
                            // Storage can be unavailable in privacy-restricted browsers.
                        }
                    }

                    window.rrAttribution = stored;

                    document.addEventListener('DOMContentLoaded', () => {
                        document.querySelectorAll('[data-attribution-field]').forEach((field) => {
                            const key = field.getAttribute('data-attribution-field');
                            field.value = stored[key] || '';
                        });
                    });
                })();
            </script>
            <script is:inline>
                document.addEventListener('DOMContentLoaded', () => {
                    if (typeof window.gtag !== 'function') {
                        return;
                    }

                    const caseStudyPath = window.location.pathname.startsWith('/case-studies');
                    const caseStudySlug = window.location.pathname.split('/').filter(Boolean)[1] || 'index';
                    const send = (eventName, params = {}) => window.gtag('event', eventName, {
                        event_category: 'case_study_engagement',
                        case_study_slug: caseStudySlug,
                        page_location: window.location.href,
                        ...params,
                    });

                    if (caseStudyPath) {
                        document.querySelectorAll('a[href="/schedule/"]').forEach((link) => link.addEventListener('click', () => send('case_study_cta_click')));
                        document.querySelectorAll('a[href^="/services/"]').forEach((link) => link.addEventListener('click', () => send('case_study_service_click', { link_url: link.href })));

                        const seen = new Set();
                        const reportScrollDepth = () => {
                            const denominator = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
                            const depth = Math.round((window.scrollY / denominator) * 100);
                            [25, 50, 75, 90].forEach((threshold) => {
                                if (depth >= threshold && !seen.has(threshold)) {
                                    seen.add(threshold);
                                    send('case_study_scroll_depth', { percent_scrolled: threshold });
                                }
                            });
                        };
                        window.addEventListener('scroll', reportScrollDepth, { passive: true });
                    }

                    const leadForm = document.querySelector('#lead-form');
                    if (leadForm) {
                        let formStarted = false;
                        leadForm.addEventListener('focusin', () => {
                            if (!formStarted) {
                                formStarted = true;
                                window.gtag('event', 'form_start', { event_category: 'engagement', form_name: 'Schedule Lead Form', page_location: window.location.href });
                            }
                        });
                        leadForm.addEventListener('submit', () => {
                            window.gtag('event', 'form_submit', {
                                event_category: 'engagement',
                                form_name: 'Schedule Lead Form',
                                page_location: window.location.href,
                            });
                            try {
                                window.sessionStorage.setItem('schedule_lead_submission_pending', '1');
                                // Enhanced conversions need the lead's own identifiers on the
                                // confirmation page, which the Netlify redirect does not carry over.
                                const readField = (name) => {
                                    const field = leadForm.querySelector(`[name="${name}"]`);
                                    return field && field.value ? field.value.trim() : '';
                                };
                                // Enhanced conversions match on E.164 numbers, so a typed
                                // US number is normalised before it is stored.
                                const toE164 = (value) => {
                                    const digits = value.replace(/\D/g, '');
                                    if (digits.length === 10) return `+1${digits}`;
                                    if (digits.length === 11 && digits.startsWith('1')) return `+${digits}`;
                                    return value.startsWith('+') ? value : '';
                                };
                                window.sessionStorage.setItem('schedule_lead_user_data', JSON.stringify({
                                    email: readField('email').toLowerCase(),
                                    phone_number: toE164(readField('phone')),
                                    landing_page: window.location.pathname,
                                    lead_scope: readField('program-scope'),
                                    lead_budget: readField('monthly-budget'),
                                }));
                            } catch {
                                // Storage can be unavailable in privacy-restricted browsers.
                            }
                        });
                    }
                });
            </script>
            <script is:inline>
                document.addEventListener('click', (event) => {
                    if (!(event.target instanceof Element)) {
                        return;
                    }

                    const phoneLink = event.target.closest('a[href^="tel:"]');

                    if (!phoneLink || typeof window.gtag !== 'function') {
                        return;
                    }

                    window.gtag('event', 'phone_call_click', {
                        event_category: 'engagement',
                        event_label: phoneLink.textContent.trim(),
                        link_url: phoneLink.href,
                        link_text: phoneLink.textContent.trim(),
                        page_location: window.location.href,
                        transport_type: 'beacon',
                    });
                });
            </script>
        
            <!-- PPC landing variant. Adding ?ppc=1 to an ad's final URL strips the
                 site navigation so the page has a single exit: the form. Runs here,
                 before first paint, so the nav never flashes in and out. The canonical
                 above is pathname-only, so the parameter adds no duplicate-content
                 surface and needs no separate route. Not persisted: a footer link
                 deliberately returns the visitor to the full site. -->
            <script is:inline>
                (() => {
                    try {
                        const v = new URLSearchParams(location.search).get('ppc');
                        if (v === '1' || v === 'true') {
                            document.documentElement.classList.add('ppc-mode');
                        }
                    } catch (e) {}
                })();
            </script>
            <style is:global>
                html.ppc-mode #cs-navigation .cs-top-social,
                html.ppc-mode #cs-navigation .cs-nav,
                html.ppc-mode #cs-navigation .cs-toggle,
                html.ppc-mode #cs-navigation .cs-ul-wrapper,
                html.ppc-mode #cs-navigation .cs-nav-button {
                    display: none !important;
                }

                /* Keep the logo as a trust mark but remove it as an exit path. */
                html.ppc-mode #cs-navigation .cs-logo {
                    pointer-events: none;
                }

                /* The header loses its nav row, so reclaim the space the hero was
                   reserving for it and retighten the anchor offset to match. */
                html.ppc-mode #schedule-hero {
                    padding-top: clamp(6.5rem, 11vw, 9rem) !important;
                }

                /* !important is required here: Astro stamps its scope attribute onto
                   every compound in the page's own rule, so that selector outranks
                   this one on class count despite being less specific by intent. */
                html.ppc-mode #schedule-main #lead-form {
                    scroll-margin-top: 6rem !important;
                }
            </style>
            <style is:global>
                /* The sitewide rule in root.less makes the root font-size a fraction of
                   viewport width above 2000px. Conversion pages set their own type scale
                   with clamp(min, vw, max), so that rule scales them a second time and
                   defeats the clamp ceilings, which are expressed in rem.

                   Gated on the class rather than rendered conditionally: Astro bundles
                   is:global styles whether or not the tag renders, so a conditional tag
                   would still apply this to every page. !important because bundle order
                   against root.less is not guaranteed. */
                @media only screen and (min-width: 2000px) {
                    html.conversion-page,
                    html.conversion-page > body {
                        font-size: 100% !important;
                    }
                }
            </style>
        </head>
        <body class={`route-${routeKey}`}>
            <template data-impeccable-contract={bodyContract ?? `impeccable:contract 34da82de
            THESIS: Restoration marketing should feel like a working signal system, not a brochure; this build refuses the generic blue-agency card wall.
            OWN-WORLD: Cobalt glaze, chalk-white surfaces, ink navy, mustard signal marks, and straight tile seams framing real proof.
            STORY: A restoration owner moves from visible constraint to connected solution to a specific assessment.
            FIRST VIEWPORT: An oversized promise on a dark cobalt field, proof or mechanism beside it, and the assessment action in the first read.
            FORM: Cobalt Tile Hall, candidate 3; seed key 34da82de.
            FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`}></template>
            <!--Screen reader skip main nav-->
            <a class="skip" aria-label="skip to main content" href="#main">Click To Skip To Main Content</a>
    
            {!conversionOnly && <Header />}
            <main id="main">
                <slot/>
            </main>
            {!conversionOnly && <Footer />}
            {!conversionOnly && <CustomChat />}
            <script is:inline>
                (() => {
                    window._paq = window._paq || [];
                    window._paq.push(['trackPageView']);
                    window._paq.push(['enableLinkTracking']);

                    let analyticsLoaded = false;
                    const loadAnalytics = () => {
                        if (analyticsLoaded) return;
                        analyticsLoaded = true;

                        const googleTag = document.createElement('script');
                        googleTag.async = true;
                        googleTag.src = 'https://www.googletagmanager.com/gtag/js?id=G-4K4H62DJ77';
                        document.head.append(googleTag);

                        const matomoUrl = 'https://remediationrestorationmarketing.matomo.cloud/';
                        window._paq.push(['setTrackerUrl', `${matomoUrl}matomo.php`]);
                        window._paq.push(['setSiteId', '1']);
                        const matomo = document.createElement('script');
                        matomo.async = true;
                        matomo.src = 'https://cdn.matomo.cloud/remediationrestorationmarketing.matomo.cloud/matomo.js';
                        document.head.append(matomo);
                    };

                    // Conversion pages cannot wait for an interaction that may never happen:
                    // a lead who lands on the confirmation page and leaves would go unreported.
                    if (window.rrEagerAnalytics) {
                        loadAnalytics();
                    } else {
                        ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach((eventName) => {
                            window.addEventListener(eventName, loadAnalytics, { once: true, passive: true });
                        });
                        window.addEventListener('load', () => window.setTimeout(loadAnalytics, 10000), { once: true });
                    }
                })();
            </script>
        </body>
        <noscript>
            <!-- Matomo Image Tracker-->
            <img referrerpolicy="no-referrer-when-downgrade" src="https://remediationrestorationmarketing.matomo.cloud/matomo.php?idsite=1&amp;rec=1" style="border:0" alt="" />
            <!-- End Matomo -->
        </noscript>
</html>
