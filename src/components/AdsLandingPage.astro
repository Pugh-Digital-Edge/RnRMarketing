---
import { Image } from "astro:assets";
import mattImage from "@assets/images/matt.webp";
import logo from "@assets/images/svg/rr-marketing-logo.svg";
import client from "@data/client.json";
import { offer, offerFaqs } from "@data/offer.js";
import { bookingUrl } from "@data/booking.js";

interface ServiceItem {
  title: string;
  text: string;
}

interface ProofItem {
  title: string;
  text: string;
}

interface ResultMetric {
  value: string;
  label: string;
}

interface ResultItem {
  label: string;
  headline: string;
  window: string;
  metrics: ResultMetric[];
}

interface HeatMap {
  src: string;
  alt: string;
  caption: string;
  note: string;
}

interface Props {
  heroTitle: string;
  heroText: string;
  servicesTitle: string;
  servicesIntro: string;
  services: ServiceItem[];
  proofItems: ProofItem[];
  resultsTitle: string;
  resultsIntro: string;
  results: ResultItem[];
  programPillars: string[];
  programNote: string;
  heatMap?: HeatMap;
}

const {
  heroTitle,
  heroText,
  servicesTitle,
  servicesIntro,
  services,
  proofItems,
  resultsTitle,
  resultsIntro,
  results,
  programPillars,
  programNote,
  heatMap,
} = Astro.props;

// Keep the landing page focused on the included website and plan; agreement
// details remain in the shared terms used elsewhere.
const landingFaqs = offerFaqs.map(faq => {
  if (faq.question === "What is the minimum commitment?") {
    return { ...faq, answer: "Your custom website is included and yours from day one. We start with a three-month plan to build your site and get your marketing underway, then continue month to month." };
  }
  if (faq.question === "What happens after we submit the form?") {
    return { question: "What happens when I book?", answer: "Choose an available time in Google Calendar and enter your details to confirm. You will receive a calendar invitation for your 30-minute Google Meet call with Matt. Bring your questions; there is nothing to prepare." };
  }
  return faq;
});
---

<div class="rm-landing">
  <header class="rm-header">
    <a class="rm-logo" href="/" aria-label="Remediation and Restoration Marketing home">
      <Image src={logo} alt="Remediation & Restoration Marketing" width={209} height={40} />
    </a>
    <a class="rm-header-cta" href={bookingUrl} data-booking-placement="header">Book a Free Strategy Call</a>
  </header>

  <section class="rm-hero" aria-labelledby="rm-hero-title">
    <div class="rm-grid" aria-hidden="true">
      <span>A</span><span>B</span><span>C</span><span>D</span>
      <span class="rm-grid-scale">RESTORATION TERRITORY / US</span>
    </div>
    <svg class="rm-territory-plot" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
      <path class="rm-plot-frame" d="M35 108H525V66H1030V144H1398V768H1110V838H564V792H35Z" />
      <path class="rm-plot-seam" d="M525 66V290L692 410V792M1030 144V338L862 488V838M35 538H316L468 424H692M862 488L1048 566H1398" />
      <path class="rm-plot-mark" d="M35 88v40M15 108h40M1398 748v40M1378 768h40M1010 144h40M1030 124v40M544 792h40M564 772v40" />
      <circle cx="692" cy="410" r="7" />
      <circle cx="862" cy="488" r="7" />
    </svg>
    <div class="rm-hero-inner">
      <div class="rm-hero-copy">
        <h1 id="rm-hero-title">{heroTitle}</h1>
        <p class="rm-hero-text">{heroText}</p>
        <div class="rm-hero-action">
          <a class="rm-hero-cta" href={bookingUrl} data-booking-placement="hero">Book a Free Strategy Call</a>
          <p><strong>Free 30-minute strategy call with Matt Pugh.</strong> Discuss your territory, visibility, and priorities. Nothing to prepare.</p>
        </div>
        <p class="rm-hero-proof"><a href="#results"><strong>5 → 18 LSA leads</strong> · Chicago-area client · May–July 2026</a><small>Reported client outcome. Results vary.</small></p>
      </div>

      <section id="book-call" class="rm-booking" aria-labelledby="rm-booking-title" data-booking-panel>
        <div class="rm-booking-heading">
          <h2 id="rm-booking-title">Choose a time with Matt.</h2>
          <p>A free 30-minute conversation about your restoration company and where you want to grow.</p>
        </div>
        <a class="rm-booking-button" href={bookingUrl} data-booking-placement="booking_panel">
          <span>Book a Free Strategy Call</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg>
        </a>
        <p class="rm-booking-help">See available times first. Add your details when you reserve your call.</p>
          <ul class="rm-call-facts" aria-label="What to expect on the call">
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              <span><strong>30 minutes</strong>Focused on your market</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h10v16H7zM9 3h6v4H9zM10 12l1.5 1.5L15 10"/></svg>
              <span><strong>Nothing to prepare</strong>Just bring your questions</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M5 21c.7-4.2 3-6 7-6s6.3 1.8 7 6"/></svg>
              <span><strong>Speak with Matt</strong>Directly with the founder</span>
            </li>
          </ul>
        <p class="rm-takeaway">{offer.takeaway}</p>
        <p class="rm-privacy-note">Booking is handled by Google Calendar. <a href="/privacy/">Privacy policy</a></p>
      </section>
    </div>
  </section>

  <section id="why-us" class="rm-specialist" aria-labelledby="rm-specialist-title">
    <div class="rm-section-shell rm-specialist-grid">
      <div class="rm-specialist-copy">
        <h2 id="rm-specialist-title">Marketing built around restoration.</h2>
        <p class="rm-lead">We help restoration owners reach more local customers. We start with how property owners search in an emergency, which services matter most, where you work, and which leads your team is ready to take.</p>
        <dl class="rm-reasons">
          <div>
            <dt>One company per territory</dt>
            <dd>We do not stack competing restoration clients in the same service territory.</dd>
          </div>
          <div>
            <dt>100% U.S.-based team</dt>
            <dd>Your work stays with our U.S.-based team. We do not outsource it.</dd>
          </div>
          <div>
            <dt>Founder-led consultation</dt>
            <dd>Your first strategy call is with Matt, and our specialists support the work that follows.</dd>
          </div>
        </dl>
        <a class="rm-text-cta" href={bookingUrl} data-booking-placement="specialist">Book a Free Strategy Call <span aria-hidden="true">→</span></a>
      </div>

      <div class="rm-owner-panel">
        <div class="rm-owner-photo">
          <Image src={mattImage} alt="Matt Pugh, founder and restoration marketing specialist" width={960} height={1200} loading="eager" decoding="async" />
        </div>
        <div class="rm-owner-caption">
          <p>Matt Pugh</p>
          <span>Founder & Restoration Marketing Specialist</span>
        </div>
        <div class="rm-owner-signal" aria-hidden="true">
          <span>FOUNDER-LED</span>
          <span>AGENCY STRATEGY</span>
        </div>
      </div>
    </div>
  </section>

  <section id="program" class="rm-system" aria-labelledby="rm-system-title">
    <div class="rm-section-shell">
      <div class="rm-system-intro">
        <h2 id="rm-system-title">{servicesTitle}</h2>
        <div class="rm-system-intro-copy">
          <p>{servicesIntro}</p>
          <dl class="rm-system-stack" aria-label="From search to booked job">
            <div><dt>Search</dt><dd>Get found</dd></div>
            <div><dt>Call or form</dt><dd>Start the conversation</dd></div>
            <div><dt>Booked job</dt><dd>Track the outcome</dd></div>
          </dl>
        </div>
      </div>

      <ol class="rm-service-rail">
        {services.map((service, index) => (
          <li>
            <div class="rm-service-node" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
            <div class="rm-service-copy">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="rm-mid-cta">
        <p>One team manages the agreed marketing work. Your team owns customer follow-up and sales closing.</p>
        <a href={bookingUrl} data-booking-placement="program">Book a Free Strategy Call <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="results" class="rm-results" aria-labelledby="rm-results-title">
    <div class="rm-section-shell">
      <div class="rm-results-head">
        <h2 id="rm-results-title">{resultsTitle}</h2>
        <p>{resultsIntro}</p>
      </div>

      <div class="rm-program-band">
        <ul class="rm-program-pillars" aria-label="What every client's program includes">
          {programPillars.map((pillar) => <li>{pillar}</li>)}
        </ul>
        <p class="rm-program-note">{programNote}</p>
      </div>

      <div class="rm-results-grid">
        {results.map((result) => (
          <article class="rm-result-card">
            <div class="rm-result-top">
              <span>{result.label}</span>
              <span>{result.window}</span>
            </div>
            <h3>{result.headline}</h3>
            <dl class="rm-result-metrics">
              {result.metrics.map((metric) => (
                <div>
                  <dt>{metric.value}</dt>
                  <dd>{metric.label}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>

      {heatMap && (
        <figure class="rm-heatmap">
          <div class="rm-heatmap-media">
            <img src={heatMap.src} alt={heatMap.alt} loading="lazy" decoding="async" data-heatmap-media />
          </div>
          <figcaption>
            <span class="rm-heatmap-label">Local rank tracking</span>
            <p class="rm-heatmap-caption">{heatMap.caption}</p>
            <p class="rm-heatmap-note">{heatMap.note}</p>
          </figcaption>
        </figure>
      )}

      <div class="rm-results-footer">
        <blockquote class="rm-testimonial"><p>“Their expertise shows in everything they do, from our website's design to our targeted marketing campaigns.”</p><footer>Jason Fogus, Owner of TRW Contracting</footer></blockquote>
      </div>
    </div>
  </section>

  <section id="commitments" class="rm-proof" aria-labelledby="rm-proof-title">
    <div class="rm-section-shell">
      <div class="rm-proof-title-wrap">
        <h2 id="rm-proof-title">What you can count on.</h2>
        <p>We would rather be clear about how we work than make vague promises.</p>
      </div>
      <div class="rm-proof-grid">
        {proofItems.map((item) => (
          <article>
            <span class="rm-proof-tick" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="how-it-works" class="rm-call" aria-labelledby="rm-call-title">
    <div class="rm-section-shell rm-call-grid">
      <div class="rm-call-copy">
        <h2 id="rm-call-title">Your {offer.session}.</h2>
        <p>Matt will look at your service territory, online visibility, and lead opportunities with you. You can ask questions, talk through what is not working, and decide whether R & R Marketing is the right fit.</p>
        <ul class="rm-call-topics" aria-label="What the call covers">
          <li>Your service territory</li>
          <li>How people find you now</li>
          <li>Your lead goals</li>
        </ul>
      </div>
      <ol class="rm-call-steps">
        <li><span>Choose your session time</span><p>Open the calendar and pick a time that works for you.</p></li>
        <li><span>Confirm your booking</span><p>Add your contact details when you reserve your time.</p></li>
        <li><span>Talk it through together</span><p>Spend 30 focused minutes with Matt. There is nothing you need to prepare.</p></li>
      </ol>
    </div>
  </section>

  <section class="rm-faq" aria-labelledby="rm-faq-title"><div class="rm-section-shell"><h2 id="rm-faq-title">Know what you’re signing up for.</h2><div class="rm-faq-list">{landingFaqs.filter(faq => faq.question !== "How much does the program cost?").map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></div></section>

  <section class="rm-checklist" aria-labelledby="rm-checklist-title"><div class="rm-section-shell"><h2 id="rm-checklist-title">Not ready for a call? Start here.</h2><p>Use our AI visibility checklist to review how clearly your restoration company can be found, understood, and cited. A practical self-check, with no custom audit or call required.</p><a href={offer.checklistPath}>Get the AI visibility checklist <span aria-hidden="true">→</span></a></div></section>

  <section class="rm-final" aria-labelledby="rm-final-title">
    <div class="rm-final-grid" aria-hidden="true"></div>
    <div class="rm-section-shell rm-final-inner">
      <div>
        <h2 id="rm-final-title">Your marketing agency should not work for your competition.</h2>
        <p>We are your marketing partner, not a shared-lead marketplace. We work with one restoration company per agreed service territory, subject to availability. Let’s start by checking yours.</p>
      </div>
      <div class="rm-final-action">
        <span>Territory availability</span>
        <p>Book a call to discuss your market and check territory availability with Matt.</p>
        <a class="rm-final-cta" href={bookingUrl} data-booking-placement="final">
          <span class="rm-final-cta-copy"><strong>Book a Free Strategy Call</strong><small>Free Lead Flow Acceleration Session</small></span>
          <span class="rm-final-cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <footer class="rm-footer">
    <div class="rm-footer-inner">
      <Image src={logo} alt="Remediation & Restoration Marketing" width={209} height={40} />
      <div class="rm-business">
        <p>{client.address.lineOne}, {client.address.lineTwo}, {client.address.city}, {client.address.state} {client.address.zip}</p>
        <p>{client.email}<span aria-hidden="true"> · </span><a href={`tel:${client.phoneForTel}`} aria-label={`Call ${client.phoneFormatted}`}>{client.phoneFormatted}</a></p>
      </div>
      <div class="rm-legal"><a href="/privacy/">Privacy</a><a href="/tos/">Terms</a></div>
    </div>
  </footer>

  <nav class="rm-mobile-cta is-hidden" aria-label="Quick contact"><a href={`tel:${client.phoneForTel}`}>Call Matt</a><a href={bookingUrl} data-booking-placement="mobile">Book a Free Strategy Call</a></nav>
</div>

<script>
  import { setupBookingClicks } from "../scripts/booking-clicks";
  setupBookingClicks();
  // Until the rank-tracking file is in place, drop the whole figure rather than
  // showing a broken image on a page that carries paid traffic.
  const heatMapImage = document.querySelector<HTMLImageElement>("[data-heatmap-media]");

  if (heatMapImage) {
    const dropHeatMap = () => {
      const figure = heatMapImage.closest(".rm-heatmap");
      if (figure) figure.remove();
    };

    heatMapImage.addEventListener("error", dropHeatMap);

    // This module runs after parsing, so a failure may already have happened.
    if (heatMapImage.complete && heatMapImage.naturalWidth === 0) {
      dropHeatMap();
    }
  }

  const bookingPanel = document.querySelector("[data-booking-panel]");
  const landingFinal = document.querySelector(".rm-final");
  const landingFooter = document.querySelector(".rm-footer");
  const stickyCta = document.querySelector(".rm-mobile-cta");

  if (bookingPanel && stickyCta && "IntersectionObserver" in window) {
    let bookingIsVisible = true;
    let finalIsVisible = false;
    let footerIsVisible = false;
    const updateStickyCta = () => stickyCta.classList.toggle("is-hidden", bookingIsVisible || finalIsVisible || footerIsVisible);
    const bookingObserver = new IntersectionObserver(
      ([entry]) => {
        bookingIsVisible = entry.isIntersecting;
        updateStickyCta();
      },
      { threshold: 0.1 },
    );
    bookingObserver.observe(bookingPanel);

    if (landingFinal) {
      const finalObserver = new IntersectionObserver(
        ([entry]) => {
          finalIsVisible = entry.isIntersecting;
          updateStickyCta();
        },
        { threshold: 0.05 },
      );
      finalObserver.observe(landingFinal);
    }

    if (landingFooter) {
      const footerObserver = new IntersectionObserver(
        ([entry]) => {
          footerIsVisible = entry.isIntersecting;
          updateStickyCta();
        },
        { threshold: 0.05 },
      );
      footerObserver.observe(landingFooter);
    }
  }

</script>

<style lang="less">
  .rm-hero-proof { margin: 1.25rem 0; font-size: .92rem; line-height: 1.6; }
  .rm-hero-proof a { color: #9cf4f2; text-decoration: underline; text-underline-offset: .2em; }
  .rm-hero-proof small { display: block; color: #dce9f7; font-size: .75rem; }
  .rm-takeaway { color: #42516a; font-size: .85rem; line-height: 1.65; margin-top: 1.5rem; }
  .rm-results-footer { display: grid; gap: 1.5rem; padding: 2rem clamp(1.25rem, 3vw, 2rem) 0; align-items: start; }
  .rm-testimonial { margin: 0; min-width: 0; color: #071a42; }
  .rm-testimonial p { font-size: 1.15rem; line-height: 1.65; }
  .rm-testimonial footer { font-size: .85rem; margin-top: 1rem; color: #42516a; }
  .rm-faq, .rm-checklist { padding: clamp(3rem, 6vw, 5rem) 1.25rem; background: #fbfcf8; }
  .rm-faq h2, .rm-checklist h2 { color: #071a42; font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.2; }
  .rm-faq h2 { text-align: center; }
  .rm-faq-list { margin: 2rem auto 0; max-width: 52rem; }
  .rm-faq details { border-bottom: 1px solid #acb9ca; }
  .rm-faq summary { cursor: pointer; color: #071a42; font-weight: 700; padding: 1.5rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; list-style: none; line-height: 1.5; }
  .rm-faq summary::-webkit-details-marker { display: none; }
  .rm-faq summary::after { content: ''; width: .6rem; height: .6rem; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); flex-shrink: 0; margin: -.3rem .25rem 0; }
  .rm-faq details[open] summary::after { transform: rotate(225deg); margin-top: .3rem; }
  .rm-faq summary:focus-visible { outline: 2px solid #0b4aa2; outline-offset: -2px; }
  .rm-faq p, .rm-checklist p { max-width: 70ch; color: #42516a; line-height: 1.75; margin: 1rem 0; }
  .rm-faq details > p { margin: 0; padding: 1.25rem 1rem 1.75rem; }
  .rm-checklist { background: #edf2f5; }
  .rm-checklist a { color: #0b4aa2; text-decoration: underline; font-weight: 700; display: inline-block; padding-block: .75rem; }
  .rm-mobile-cta a { color: inherit; display: flex; align-items: center; justify-content: center; min-height: 44px; flex: 1; padding: .3rem .6rem; }
  .rm-mobile-cta a + a { border-left: 1px solid #071a42; }

  .rm-landing {
    --rm-ink: #071a42;
    --rm-cobalt: #0b4aa2;
    --rm-cyan: #23c6d5;
    --rm-chalk: #fbfcf8;
    --rm-mist: #edf2f5;
    --rm-mustard: #efb43f;
    --rm-line: rgba(7, 26, 66, 0.16);
    background: var(--rm-chalk);
    color: var(--rm-ink);
  }

  .rm-landing a:focus-visible,
  .rm-landing button:focus-visible,
  .rm-landing input:focus-visible {
    outline: 3px solid var(--rm-mustard);
    outline-offset: 3px;
  }

  .rm-header {
    min-height: 4.75rem;
    padding: 0.85rem clamp(1rem, 4vw, 4rem);
    background: var(--rm-ink);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .rm-logo { display: block; width: min(13rem, 62vw); }
  .rm-logo img { width: 100%; height: auto; filter: brightness(0) invert(1); display: block; }

  .rm-header-cta,
  .rm-hero-cta,
  .rm-text-cta,
  .rm-mid-cta a,
  .rm-final-cta {
    font-size: 0.78rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .rm-header-cta,
  .rm-hero-cta {
    color: var(--rm-ink) !important;
    background: var(--rm-mustard);
    padding: 0.9rem 1.1rem;
    border-radius: 0.25rem;
  }

  .rm-hero {
    min-height: calc(100svh - 4.75rem);
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(circle at 18% 34%, rgba(35, 198, 213, 0.18), transparent 30rem),
      linear-gradient(120deg, #071a42 0%, #082c69 48%, #071a42 100%);
  }

  .rm-grid,
  .rm-final-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.58;
    background-image:
      linear-gradient(rgba(35, 198, 213, 0.11) 1px, transparent 1px),
      linear-gradient(90deg, rgba(35, 198, 213, 0.11) 1px, transparent 1px);
    background-size: 5rem 5rem;
    mask-image: linear-gradient(90deg, #000, rgba(0, 0, 0, 0.35) 70%, transparent);
  }

  .rm-grid > span:not(.rm-grid-scale) {
    display: none;
  }

  .rm-grid-scale {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: rgba(134, 237, 235, 0.72);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
  }

  .rm-territory-plot {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.48;
    fill: none;
    stroke: var(--rm-cyan);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .rm-plot-frame { stroke-dasharray: 4 9; }
  .rm-plot-seam { opacity: 0.68; }
  .rm-plot-mark { stroke: var(--rm-mustard); stroke-width: 1.5; }
  .rm-territory-plot circle { fill: var(--rm-ink); stroke-width: 1.5; }

  .rm-hero-inner,
  .rm-section-shell,
  .rm-footer-inner {
    width: calc(100% - 2rem); max-width: 80rem;
    margin-inline: auto;
  }

  .rm-hero-inner {
    min-height: inherit;
    padding: clamp(2rem, 4vw, 3.5rem) 0;
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
  }

  .rm-hero-copy { align-self: start; }

  .rm-hero h1 {
    max-width: 14ch;
    color: #fff !important;
    font-size: clamp(2.5rem, 5.6vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.04em !important;
    text-wrap: balance;
  }

  .rm-hero-text {
    max-width: 62ch;
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.82) !important;
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.6;
  }

  .rm-hero-action {
    margin-top: 1.25rem;
    display: grid;
    justify-items: start;
    gap: 0.65rem;
  }
  .rm-hero-cta {
