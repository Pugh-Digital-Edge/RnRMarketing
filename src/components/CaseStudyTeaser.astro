---
import { caseStudies } from '@data/caseStudies.js';
const { compact = false } = Astro.props;
const featured = caseStudies.slice(0, 3);
---

<section class:list={["case-teaser", { compact }]} aria-labelledby="case-teaser-title">
  <div class="case-teaser-container">
    <div class="case-teaser-copy">
      <span class="case-teaser-label">Reported client outcomes</span>
      <h2 id="case-teaser-title">See the work in context.</h2>
      <p>Anonymous, report-led stories showing how SEO, local visibility, paid lead capture, and conversion work reinforce each other.</p>
      <a class="case-teaser-link" href="/case-studies/">Read all case studies <span aria-hidden="true">→</span></a>
    </div>
    <div class="case-teaser-list">
      {featured.map((study) => (
        <a class="case-teaser-item" href={`/case-studies/${study.slug}/`}>
          <span class="case-teaser-stat">{study.metrics[0].value}</span>
          <span class="case-teaser-item-copy"><strong>{study.label}</strong><span>{study.proofLine}</span></span>
          <span class="case-teaser-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style lang="less">
  .case-teaser { padding: var(--sectionPadding); background: #071a32; color: #fff; }
  .case-teaser-container { width: 100%; max-width: 80rem; margin: auto; display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .case-teaser-copy { max-width: 34rem; }
  .case-teaser-label { display: block; margin-bottom: .75rem; color: #86c8ff; font-size: .75rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .case-teaser h2 { margin: 0 0 1rem; color: #fff; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.05; }
  .case-teaser p { margin: 0 0 1.5rem; color: rgba(255,255,255,.76); max-width: 40rem; }
  .case-teaser-link { color: #fff; font-weight: 700; text-decoration: none; }
  .case-teaser-link span { color: #86c8ff; margin-left: .35rem; }
  .case-teaser-list { display: grid; border-top: 1px solid rgba(255,255,255,.2); }
  .case-teaser-item { min-height: 5.5rem; display: grid; grid-template-columns: 7rem 1fr auto; gap: 1rem; align-items: center; border-bottom: 1px solid rgba(255,255,255,.2); color: #fff; text-decoration: none; transition: transform .2s ease, background .2s ease; }
  .case-teaser-item:hover { transform: translateX(.35rem); background: rgba(255,255,255,.05); }
  .case-teaser-stat { color: #86c8ff; font-size: clamp(1.25rem, 3vw, 1.75rem); font-weight: 800; letter-spacing: -.04em; }
  .case-teaser-item-copy { display: grid; gap: .2rem; }
  .case-teaser-item-copy strong { font-size: 1rem; }
  .case-teaser-item-copy span { color: rgba(255,255,255,.65); font-size: .875rem; }
  .case-teaser-arrow { color: #86c8ff; font-size: 1.4rem; }
  @media (max-width: 47.99rem) {
    .case-teaser-copy { margin-inline: auto; text-align: center; }
    .case-teaser-list { text-align: center; }
    .case-teaser-item { grid-template-columns: 1fr; justify-items: center; gap: .5rem; padding: 1.25rem 0; }
    .case-teaser-item:hover { transform: translateY(-.2rem); }
  }
  @media (min-width: 48rem) { .case-teaser-container { grid-template-columns: .85fr 1.15fr; } }
  @media (max-width: 30rem) { .case-teaser-item { grid-template-columns: 5.5rem 1fr auto; } }
</style>
