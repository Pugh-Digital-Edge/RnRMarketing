const { service } = Astro.props as { service: keyof typeof guides };
const guide = guides[service];
const anchorPrefix = service === "seo" ? "restoration-seo" : service;

if (!guide) {
  throw new Error(`Unknown ServiceDepth service: ${service}`);
}
---

<section class="service-depth" aria-labelledby={`service-depth-${service}`}>
  <div class="service-depth__container">
    <header class="service-depth__intro">
      <h2 id={`service-depth-${service}`}>{guide.title}</h2>
      <p>{guide.intro}</p>
    </header>

    <div class="service-depth__work" id={`${anchorPrefix}-system`}>
      {guide.work.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>

    <div class="service-depth__process" id={`${anchorPrefix}-process`}>
      <div>
        <h2>What the working process looks like</h2>
        <p>The sequence keeps the service tied to restoration operations and makes each recommendation verifiable.</p>
      </div>
      <ol>
        {guide.process.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </div>

    <aside class:list={["service-depth__evidence", { "service-depth__evidence--no-metrics": guide.evidence.metrics.length === 0 }]} id={`${anchorPrefix}-evidence`} aria-labelledby={`service-evidence-${service}`}>
      <div class="service-depth__evidence-copy">
        <h2 id={`service-evidence-${service}`}>{guide.evidence.title}</h2>
        <p>{guide.evidence.text}</p>
        <a href="/case-studies/">Review the full reported client stories <span aria-hidden="true">→</span></a>
      </div>
      {guide.evidence.metrics.length > 0 && (
        <dl>
          {guide.evidence.metrics.map((metric) => (
            <div>
              <dt>{metric.value}</dt>
              <dd>{metric.label}</dd>
            </div>
          ))}
        </dl>
      )}
    </aside>

    <div class="service-depth__reference">
      <section aria-labelledby={`terms-${service}`}>
        <h2 id={`terms-${service}`}>Terms restoration owners should know</h2>
        <dl>
          {guide.definitions.map((item) => (
            <div>
              <dt>{item.term}</dt>
              <dd>{item.meaning}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id={`${anchorPrefix}-faqs`} aria-labelledby={`questions-${service}`}>
        <h2 id={`questions-${service}`}>Questions to ask before committing</h2>
        <div class="service-depth__faq">
          {guide.faqs.map((item) => (
            <details>
              <summary><h3>{item.question}</h3></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </div>

    {guide.evidence.metrics.length > 0 && (
      <p class="service-depth__method">
        Reporting note: figures above come from anonymized May–July 2026 client reporting and remain qualified where sources overlap or platform definitions differ. They describe observed outcomes, not guaranteed results.
      </p>
    )}
  </div>
</section>

<style lang="less">
  .service-depth {
    padding: var(--sectionPadding);
    background: var(--surface);
    color: var(--bodyTextColor);
  }

  .service-depth__container {
    width: min(100%, 80rem);
    margin: 0 auto;
  }

  .service-depth__intro {
    max-width: 48rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.75rem);

    h2 {
      max-width: 18ch;
      margin: 0 0 1rem;
      color: var(--headerColor);
      font-size: clamp(2.15rem, 5vw, 4.25rem);
      line-height: 1.05;
      letter-spacing: -.04em;
      text-wrap: balance;
    }

    p {
      max-width: 70ch;
      margin: 0;
      font-size: clamp(1.05rem, 2vw, 1.2rem);
      line-height: 1.75;
    }
  }

  .service-depth__work {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-bottom: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--borderColor);
    border-bottom: 1px solid var(--borderColor);

    article {
      padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1rem, 3vw, 2rem);
      border-bottom: 1px solid var(--borderColor);
    }

