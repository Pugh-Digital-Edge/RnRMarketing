      { title: "Instrument the path", text: "Configure analytics, call tracking, forms, campaign tags, and platform conversions without exposing private customer information." },
      { title: "Reconcile the sources", text: "Check platform totals against calls and customer records, documenting overlap or missing attribution." },
      { title: "Use the result", text: "Move budget and page work toward the sources producing viable work, not merely the largest activity count." },
