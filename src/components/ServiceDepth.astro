---
interface Detail {
  title: string;
  text: string;
}

interface Definition {
  term: string;
  meaning: string;
}

interface FAQ {
  question: string;
  answer: string;
}

interface ServiceGuide {
  title: string;
  intro: string;
  work: Detail[];
  process: Detail[];
  evidence: {
    title: string;
    text: string;
    metrics: { value: string; label: string }[];
  };
  definitions: Definition[];
  faqs: FAQ[];
}

const guides: Record<string, ServiceGuide> = {
  seo: {
    title: "What restoration SEO work should actually include",
    intro: "Restoration SEO is the work of making the right service, location, and proof pages easy to find, understand, and trust. The useful unit is not a keyword added to a page. It is a complete path from a high-intent search to a qualified call or estimate request.",
    work: [
      { title: "Service and location ownership", text: "Assign each important search intent to one primary page, then make that page specific enough to deserve the ranking. This reduces overlap between generic services, specialty services, and city pages." },
      { title: "Local trust signals", text: "Keep Google Business Profile services, reviews, business information, service areas, and on-site entity details consistent so local search systems can connect the company to the work it performs." },
      { title: "Useful restoration answers", text: "Publish practical explanations, decision guides, process details, and job-based proof that help owners, managers, and adjusters make a decision—not filler written only to repeat a phrase." },
