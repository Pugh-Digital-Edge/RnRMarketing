      { title: "Define eligible journeys", text: "Choose the pages, audiences, consent signals, and business cases that justify follow-up." },
      { title: "Build message sequence", text: "Move from reminder to proof to a practical next step instead of repeating one ad indefinitely." },
      { title: "Control exposure", text: "Set audience duration, exclusions, and frequency appropriate to the service and platform." },
      { title: "Compare incremental value", text: "Review whether retargeted users produce qualified actions beyond what direct return traffic would likely have done." },
    ],
    evidence: {
      title: "How client reporting informs this service",
      text: "Recent restoration reports reinforce the need to connect page visits, calls, forms, LSA leads, and profile actions without double counting. They do not isolate retargeting as the cause of those outcomes. That is why our retargeting reporting keeps click-through, view-through, assisted, and direct conversions separate.",
      metrics: [],
    },
    definitions: [
      { term: "Audience duration", meaning: "How long a person remains eligible for a retargeting audience after the qualifying interaction." },
      { term: "Frequency cap", meaning: "A limit on how often an ad may be shown to the same person in a set period." },
      { term: "Incrementality", meaning: "The additional outcome caused by a campaign beyond what likely would have happened without it." },
    ],
    faqs: [
      { question: "Is retargeting appropriate after an emergency visit?", answer: "Sometimes, but it requires restraint. Sensitive-loss pages need appropriate consent, short audience windows, careful exclusions, and useful messaging. Some situations should not be retargeted at all." },
      { question: "How long should a retargeting audience last?", answer: "It depends on the decision cycle. Emergency intent may justify a very short window, while commercial planning or reconstruction can support a longer one. The duration should match the real buying process." },
      { question: "Does retargeting replace search advertising?", answer: "No. Search captures active demand; retargeting follows up with people who already interacted. They solve different problems and should be measured separately." },
    ],
  },
