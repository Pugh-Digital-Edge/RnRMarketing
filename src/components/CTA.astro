---
import { offer } from "@data/offer.js";
---
<section id="cta-52" aria-labelledby="closing-cta-title">
  <div class="cs-container">
    <div class="cs-content">
      <h2 class="cs-title" id="closing-cta-title">Get a Clearer Plan for More Qualified Restoration Leads</h2>
      <p class="cs-text">We review your service territory, visibility, and lead opportunities in your free {offer.session}.</p>
      <p class="cta-territory">{offer.territory}</p>
    </div>
    <div class="cta-next-step">
      <h3>Your next step</h3>
      <p>30 minutes with Matt. No obligation.</p>
      <a href="/schedule/" class="cs-button-solid">Request Your Free Session</a>
      <p>{offer.takeaway}</p>
      <a href={offer.checklistPath} class="cta-checklist">Get the AI visibility checklist</a>
    </div>
  </div>
</section>
<style>
  #cta-52 { background: #071a42; padding: 4rem 1rem; }
  .cs-container { max-width: 80rem; margin: auto; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .cs-title { color: #fff; font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1.15; margin: 0 0 1.5rem; max-width: 23ch; }
  .cs-text, .cta-territory, .cta-next-step p { color: #dce6f4; line-height: 1.7; margin: 0 0 1.25rem; }
  .cta-next-step { border-top: 1px solid #6680a6; padding-top: 1.5rem; }
  h3 { color: #fff; font-size: 1.4rem; margin: 0 0 .75rem; }
  .cs-button-solid { margin-bottom: 1.5rem; }
  .cta-checklist { display: inline-flex; align-items: center; min-height: 44px; color: #fff; text-decoration: underline; text-underline-offset: .2em; }
  @media(max-width: 767px) { .cs-container { grid-template-columns: 1fr; } }
</style>
