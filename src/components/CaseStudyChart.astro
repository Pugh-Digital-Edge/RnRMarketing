---
const { chart } = Astro.props;
const periods = ['May', 'June', 'July'];
const max = chart.max ?? Math.max(...chart.values);
const formatValue = (value) => `${chart.prefix ?? ''}${Number(value).toLocaleString('en-US', { minimumFractionDigits: chart.decimals ?? 0, maximumFractionDigits: chart.decimals ?? 0 })}${chart.suffix ?? ''}`;
---

<figure class="evidence-chart">
  <figcaption>
    <strong>{chart.title}</strong>
    <span>{chart.description}</span>
  </figcaption>
  <div class="chart-plot" role="img" aria-label={`${chart.title}: ${periods.map((period, index) => `${period} ${formatValue(chart.values[index])}`).join(', ')}`}>
    {chart.values.map((value, index) => (
      <div class="chart-column">
        <span class="chart-value">{formatValue(value)}</span>
        <div class="chart-track" aria-hidden="true"><span class="chart-bar" style={`height: ${Math.max((value / max) * 100, 8)}%`}></span></div>
        <span class="chart-period">{periods[index]}</span>
      </div>
    ))}
  </div>
  <table class="chart-table">
    <caption class="sr-only">{chart.title} by reporting period</caption>
    <thead><tr><th scope="col">Period</th>{periods.map((period) => <th scope="col">{period}</th>)}</tr></thead>
    <tbody><tr><th scope="row">Reported</th>{chart.values.map((value) => <td>{formatValue(value)}</td>)}</tr></tbody>
  </table>
</figure>

<style lang="less">
  .evidence-chart {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--borderColor);
    border-radius: 1.25rem;
    background: var(--surface);
    box-shadow: var(--shadowS);
  }

  figcaption { display: grid; gap: .3rem; margin-bottom: 1.5rem; }
  figcaption strong { font-size: 1.05rem; color: var(--headerColor); }
  figcaption span { color: var(--bodyTextColor); font-size: .875rem; line-height: 1.45em; }
  .chart-plot { min-height: 12rem; display: flex; align-items: end; justify-content: space-around; gap: 1rem; padding: 0 .5rem .75rem; border-bottom: 1px solid var(--borderColor); }
  .chart-column { height: 11.25rem; flex: 1; display: grid; grid-template-rows: auto 1fr auto; gap: .5rem; align-items: end; text-align: center; }
  .chart-value, .chart-period { font-size: .75rem; color: var(--headerColor); font-weight: 700; }
  .chart-period { color: var(--secondary); font-weight: 600; }
  .chart-track { height: 100%; display: flex; align-items: end; justify-content: center; background: linear-gradient(to top, rgba(10, 102, 194, .08) 1px, transparent 1px); background-size: 100% 25%; }
  .chart-bar { width: min(3.25rem, 70%); min-height: .5rem; border-radius: .55rem .55rem .2rem .2rem; background: linear-gradient(180deg, var(--primaryLight), var(--primaryDark)); box-shadow: 0 .5rem 1rem rgba(10, 102, 194, .16); transform-origin: bottom; animation: rise .8s cubic-bezier(.2,.75,.25,1) both; }
  .chart-table { width: 100%; margin-top: 1rem; border-collapse: collapse; font-size: .8rem; }
  .chart-table th, .chart-table td { padding: .35rem; text-align: right; border-bottom: 1px solid var(--borderColor); }
  .chart-table th:first-child, .chart-table td:first-child { text-align: left; }
  .chart-table th { color: var(--secondary); font-weight: 600; }
  .chart-table td { color: var(--headerColor); font-weight: 700; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @keyframes rise { from { transform: scaleY(0); opacity: .4; } to { transform: scaleY(1); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .chart-bar { animation: none; } }
</style>
