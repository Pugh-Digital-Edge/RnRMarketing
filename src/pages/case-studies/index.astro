---
import BaseLayout from 'src/layouts/BaseLayout.astro';
import CaseStudyTeaser from '@components/CaseStudyTeaser.astro';
import { caseStudies, caseStudyServices } from '@data/caseStudies.js';
import landingImage from '@assets/images/landing/ocean-water.jpg';
---

<BaseLayout title="Restoration Marketing Case Studies" description="Anonymous, report-led case studies showing how restoration marketing programs improve local visibility, leads, calls, and cost efficiency." preloadedImage={landingImage} openGraphImage="/assets/images/case-study-og.svg" dateModified="2026-08-06">
  <section class="case-index-hero"><div class="case-index-container"><p class="case-index-label">Reported client outcomes</p><h1>Proof you can actually trace.</h1><p>See how restoration-focused SEO, Google Business Profile work, Local Services Ads, web design, and lead tracking came together across three reporting windows.</p><a class="cs-button-solid" href="/schedule/">Request Your Free Session</a></div></section>
  <section class="case-index-intro"><div class="case-index-container intro-grid"><div><p class="case-index-label">Why these stories are different</p><h2>Outcomes first. Claims kept in proportion.</h2></div><p>These stories use broad geographies and anonymous labels by design. They separate reported visibility and lead outcomes from customer-confirmed jobs, and keep every metric in its original reporting context.</p></div></section>
  <main class="case-index-list"><div class="case-index-container"><div class="case-index-list-heading"><h2>Choose a story</h2><span>Three reporting windows · one reusable framework</span></div><div class="case-cards">{caseStudies.map((study, index) => <article class="case-card"><div class="case-card-top"><span>0{index + 1}</span><span>{study.window}</span></div><p class="case-card-label">{study.label}</p><h3>{study.headline}</h3><p>{study.summary}</p><div class="case-card-metrics">{study.metrics.slice(0, 2).map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div><div class="case-card-footer"><span>{study.proofLine}</span><a href={`/case-studies/${study.slug}/`}>Read story <span aria-hidden="true">↗</span></a></div></article>)}</div></div></main>
  <section class="case-index-services"><div class="case-index-container"><div><p class="case-index-label">Build your own proof loop</p><h2>Start with the service that matches your constraint.</h2></div><div class="service-link-grid">{caseStudyServices.map((service) => <a href={service.href}>{service.label}<span aria-hidden="true">↗</span></a>)}</div></div></section>
  <CaseStudyTeaser compact />
</BaseLayout>

<style lang="less">
  .case-index-container { width: min(100% - 2rem, 80rem); margin-inline: auto; }
  .case-index-hero { padding: clamp(9rem, 18vw, 14rem) 0 clamp(4rem, 8vw, 7rem); color: #fff; background: radial-gradient(circle at 80% 10%, rgba(59,142,222,.32), transparent 34rem), #071a32; }
  .case-index-hero h1 { max-width: 9ch; margin: 0 0 1.25rem; color: #fff; font-size: clamp(3.5rem, 9vw, 7rem); line-height: .9; letter-spacing: -.07em; }
  .case-index-hero p:not(.case-index-label) { max-width: 43rem; margin: 0 0 2rem; color: rgba(255,255,255,.78); font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .case-index-label { margin: 0 0 .85rem; color: var(--primary); font-size: .75rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  .case-index-hero .case-index-label { color: #86c8ff; }
  .case-index-hero .cs-button-solid { background: #86c8ff !important; color: #071a32 !important; box-shadow: none; }
  .case-index-intro { padding: clamp(4rem, 8vw, 7rem) 0; }
  .intro-grid { display: grid; gap: 2rem; align-items: end; }
  .intro-grid h2, .case-index-services h2 { max-width: 16ch; margin: 0; font-size: clamp(2.2rem, 5vw, 4.25rem); line-height: 1; letter-spacing: -.055em; }
  .intro-grid > p { max-width: 40rem; margin: 0; color: var(--bodyTextColor); font-size: 1.05rem; }
  .case-index-list { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--surfaceMuted); }
  .case-index-list-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: end; margin-bottom: 2rem; }
  .case-index-list-heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.04em; }
  .case-index-list-heading span { color: var(--secondary); font-size: .8rem; font-weight: 700; }
  .case-cards { display: grid; gap: 1rem; }
  .case-card { padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--borderColor); border-radius: 1.25rem; background: var(--surface); box-shadow: var(--shadowS); }
  .case-card-top, .case-card-footer { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  .case-card-top { padding-bottom: 1rem; margin-bottom: 2rem; border-bottom: 1px solid var(--borderColor); color: var(--secondary); font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .case-card-top span:first-child { color: var(--primary); font-size: 1rem; }
  .case-card-label { margin-bottom: .5rem; color: var(--primary); font-size: .8rem; font-weight: 800; }
  .case-card h3 { max-width: 18ch; margin: 0 0 .8rem; font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1.05; }
  .case-card > p:not(.case-card-label) { min-height: 5rem; margin: 0; color: var(--bodyTextColor); }
  .case-card-metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; padding: 1.5rem 0; margin-top: 1.5rem; border-top: 1px solid var(--borderColor); border-bottom: 1px solid var(--borderColor); }
  .case-card-metrics div { display: grid; gap: .2rem; }
  .case-card-metrics strong { color: var(--headerColor); font-size: clamp(1.25rem, 3vw, 1.75rem); letter-spacing: -.04em; }
  .case-card-metrics span { color: var(--secondary); font-size: .75rem; line-height: 1.35; }
  .case-card-footer { padding-top: 1.25rem; }
  .case-card-footer > span { color: var(--secondary); font-size: .8rem; }
  .case-card-footer a { color: var(--primary); font-size: .875rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .case-index-services { padding: clamp(4rem, 8vw, 7rem) 0; }
  .case-index-services > .case-index-container { display: grid; gap: 2rem; align-items: end; }
  .service-link-grid { display: grid; gap: .6rem; }
  .service-link-grid a { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--borderColor); color: var(--headerColor); font-weight: 700; text-decoration: none; }
  .service-link-grid a span { color: var(--primary); }
  @media (max-width: 47.99rem) {
    .case-index-hero .case-index-container, .case-index-intro .case-index-container, .case-index-services > .case-index-container { text-align: center; }
    .case-index-hero h1, .intro-grid h2, .case-index-services h2 { margin-inline: auto; }
    .case-index-hero p:not(.case-index-label) { margin-inline: auto; }
    .case-index-hero .cs-button-solid { display: table; margin-inline: auto; }
    .case-index-list-heading { flex-direction: column; align-items: center; text-align: center; }
    .case-card { text-align: center; }
    .case-card-top, .case-card-footer { justify-content: center; }
    .service-link-grid a { justify-content: center; }
  }
  @media (min-width: 48rem) { .intro-grid, .case-index-services > .case-index-container { grid-template-columns: .85fr 1.15fr; gap: clamp(3rem, 8vw, 8rem); } .case-cards { grid-template-columns: repeat(3, 1fr); } .case-card > p:not(.case-card-label) { min-height: 7rem; } }
</style>
