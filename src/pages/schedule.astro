---
import BaseLayout from "src/layouts/BaseLayout.astro";
import { getOptimizedImage } from "@libs/utils";
import landingImage from "@assets/images/landing/blue-abstract.jpeg";
import CaseStudyTeaser from "@components/CaseStudyTeaser.astro";

const optimizedImage = await getOptimizedImage(landingImage);

const proofImages = [
  {
    src: "/assets/images/schedule/leadflow-proof-3.webp",
    alt: "Restoration marketing client proof",
    width: 1200,
    height: 244,
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Free Lead Flow Acceleration Session",
  description:
    "Free 30-minute session for restoration contractors looking to identify lead opportunities through focused digital marketing.",
  url: "https://remediationrestorationmarketing.com/schedule/",
  provider: {
    "@type": "Organization",
    name: "Remediation & Restoration Marketing",
    url: "https://remediationrestorationmarketing.com/",
  },
  areaServed: {
    "@type": "Audience",
    audienceType: "Restoration contractors, USA",
  },
};

const assessmentSteps = [
  {
    name: "Review your market opportunity",
    text: "We look at where restoration demand is strongest in your service area and where competitors are winning.",
  },
  {
    name: "Inspect visibility and lead flow",
    text: "We review the website, local search, and paid advertising gaps holding back your emergency lead flow.",
  },
  {
    name: "Leave with prioritized next steps",
    text: "You leave with practical recommendations for capturing more qualified restoration jobs.",
  },
];

const assessmentFaqs = [
  {
    question: "What happens after I request a session?",
    answer: "We review your service area, online visibility, and lead goals, then reach out with the next steps for your free Lead Flow Acceleration Session.",
  },
  {
    question: "How long is the session?",
    answer: "About 30 minutes. That is enough time to review your market, your visibility, and your competition, and to leave you with a prioritized list of what to fix first.",
  },
  {
    question: "What will you review before the call?",
    answer: "We look at your website, local search presence, service area, restoration keywords, and visible competitor activity so the session is specific to your market.",
  },
  {
    question: "Is this just a sales pitch?",
    answer: "No. The session is designed to give you practical observations about where restoration leads may be leaking and which growth moves are worth prioritizing.",
  },
  {
    question: "Do you work with my competitors?",
    answer: "No. We do not work with competing restoration companies in the same service area. When you work with us, we will not take on a competitor in your market.",
  },
  {
    question: "Who is this best for?",
    answer: "It is built for restoration contractors who want more water damage, fire damage, mold remediation, storm cleanup, or commercial restoration leads in a defined service area.",
  },
  {
    question: "Do I need to prepare anything?",
    answer: "Just share accurate contact details, your company name, service area, and the services you want to grow. If there is a specific challenge you want reviewed, include it in the goals field.",
  },
];

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "@id": "https://remediationrestorationmarketing.com/schedule/#assessment-process",
  name: "How to prepare for a restoration marketing session",
  description: "A three-step process for reviewing restoration marketing opportunities and choosing the next practical growth moves.",
  step: assessmentSteps.map((step) => ({ "@type": "HowToStep", ...step })),
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://remediationrestorationmarketing.com/schedule/#faq",
  mainEntity: assessmentFaqs.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<BaseLayout
  title="Free Lead Flow Acceleration Session for Restoration Contractors"
  description="Request a free Lead Flow Acceleration Session for your restoration company. Share your territory, services, and goals so we can review your lead opportunities."
  preloadedImage={optimizedImage}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)}></script>

  <section id="schedule-hero">
    <div class="cs-container">
      <span class="hero-eyebrow">One restoration company per market</span>
      <h1>More <span>Water, Fire, and Mold</span> Jobs From Your Service Area</h1>
      <p>
        Request a free Lead Flow Acceleration Session. We review your territory, your online visibility, and where competitors are winning the emergency calls, then show you the next moves worth making.
      </p>
      <a href="#lead-form" class="cs-button-solid">Request Your Free Session</a>
      <ul class="hero-trust">
        <li>30-minute session</li>
        <li>No obligation</li>
        <li>Not a sales pitch</li>
      </ul>
    </div>
  </section>

  <section id="schedule-main">
    <div class="cs-container">
      <div class="cs-media">
        <h2>A Quick Word Before You Book</h2>
        <p class="cs-video-intro">A short intro to the session and how to get yours scheduled.</p>
        <div class="cs-video" aria-label="Lead Flow Acceleration Session video">
          <button class="cs-video-placeholder" type="button" data-youtube-id="SA49vYXmCM0" aria-label="Play Lead Flow Acceleration Session video">
            <img src="https://i.ytimg.com/vi/SA49vYXmCM0/hqdefault.jpg" alt="" width="480" height="360" loading="lazy" decoding="async" />
            <span aria-hidden="true">Play video</span>
          </button>
        </div>
        <a href="#lead-form" class="cs-brand-card-link">
          <img
            src="/assets/images/schedule/apply-now.webp"
            alt="Request your free Acceleration Session"
            class="cs-brand-card"
            loading="lazy"
            decoding="async"
            width="1200"
            height="678"
          />
        </a>
      </div>

      <form id="lead-form" name="Schedule Lead Form" method="post" action="/.netlify/functions/submit-lead" data-success-redirect="/thank-you/" data-lead-phone-form data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="Schedule Lead Form" />
        <p hidden>
          <label>
            Do not fill this out if you are human:
            <input name="bot-field" />
          </label>
        </p>
        <span class="cs-topper">REQUEST YOUR SESSION</span>
        <h2>Tell Us Where You Want More Jobs</h2>
        <p>
          Takes about 60 seconds. We review your details and get back to you within one business day.
        </p>
        <ul class="cs-form-outcomes" aria-label="Session outcomes">
          <li>Know which services to prioritize first</li>
          <li>See where competitors are outranking you</li>
          <li>Get a prioritized list of what to fix</li>
        </ul>

        <label>
          Name
          <input required type="text" name="name" placeholder="Your name" />
        </label>
        <label>
          Email
          <input required type="email" name="email" placeholder="you@example.com" />
        </label>
        <div data-phone-field>
          <label>
            Country
            <select name="phone-country" data-phone-country aria-label="Phone number country"><option value="US">United States +1</option></select>
          </label>
          <label>
            Phone
            <input required type="tel" inputmode="tel" autocomplete="tel" name="phone" data-phone-input aria-describedby="schedule-phone-error" placeholder="(310) 555-1234" />
          </label>
          <p id="schedule-phone-error" data-phone-error role="alert" hidden>Please enter a valid phone number, including the area code.</p>
        </div>
        <label>
          Service Area
          <input required type="text" name="service-area" placeholder="City, state, or ZIP codes" />
        </label>

        <button class="cs-button-solid cs-form-continue" type="button">Next Step (30 Seconds)</button>

        <div class="cs-form-step" data-step="2" hidden>
          <label>
            Company
            <input required type="text" name="company" placeholder="Company name" />
          </label>
          <label>
            Primary Service
            <select name="primary-service" required>
              <option value="">Select a service</option>
              <option>Water Damage Restoration</option>
              <option>Fire Damage Restoration</option>
              <option>Mold Remediation</option>
              <option>Storm Damage Cleanup</option>
              <option>Commercial Restoration</option>
              <option>Multiple Restoration Services</option>
            </select>
          </label>
          <label class="cs-full">
            What are you trying to improve?
            <textarea
              name="goals"
              placeholder="Example: more emergency water calls, better Google rankings, lower cost per lead..."
            ></textarea>
          </label>

          <button class="cs-button-solid" type="submit">Request My Free Session</button>
          <small>We use these details to prepare your session. No obligation and no sales pressure. We don’t work with competing restoration companies in the same market.</small>
        </div>
      </form>
    </div>
  </section>

  <section id="schedule-results">
    <div class="cs-container">
      <div class="cs-copy">
        <span class="cs-topper">Client Proof</span>
        <h2 class="cs-title">What Changes When Restoration Marketing Gets Focused</h2>
        <p class="cs-text">
          Target the right keywords in the right territory and your website stops being a brochure. It becomes a
          predictable source of leads, estimates, and booked jobs.
        </p>
      </div>
      <div class="cs-gallery">
        {proofImages.map((image) => (
          <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
        ))}
      </div>
      <blockquote>
        "Thank you for your time this morning Matt! I was concerned that this would be a sales pitch or a waste of
        time, but I can honestly say that you exceeded my expectations. You came prepared with details on our website,
        our rankings, and actionable insights. It was refreshing to talk with a real expert without feeling like I was
        getting the hard sale."
        <cite>Jason Fogus, TRW Contracting</cite>
      </blockquote>
      <a href="#lead-form" class="cs-button-solid">Request Your Free Acceleration Session</a>
    </div>
  </section>

  <CaseStudyTeaser compact />

  <section id="schedule-proof">
    <div class="cs-container">
      <div class="cs-content">
        <span class="cs-topper">A FOCUSED WORKING SESSION</span>
        <h2 class="cs-title">What We Review in Your Session</h2>
        <p class="cs-text">
          We look at your market, your visibility, and your competition, then tell you what to fix first.
        </p>
      </div>
      <ul>
        {assessmentSteps.map((step) => (
          <li>
            <strong>{step.name}</strong>
            {step.text}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="schedule-faq">
    <div class="cs-container">
      <span class="cs-topper">FAQ</span>
      <h2 class="cs-title">Acceleration Session Questions</h2>
      <div class="cs-faq-list">
        {assessmentFaqs.map((faq, index) => (
          <details open={index === 0}>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <button class="schedule-mobile-cta" type="button">Request Your Free Session</button>
</BaseLayout>

<style lang="less">
  @media only screen and (min-width: 0rem) {
    #schedule-hero {
      padding: clamp(9rem, 16vw, 13rem) 1rem clamp(3rem, 6vw, 5rem);
      position: relative;
      isolation: isolate;
      overflow: hidden;
      color: #fff;
      // Layered depth: two brand-family glows over a darkened photo. Opacities
      // are set from measurement, not taste. hero.webp contains near-white
      // pixels (253,255,254), so a lighter stack pushed the worst-case
      // background to rgb(40,126,182) and dropped body copy to 3.81:1. At these
      // values the lightest point of the gradient is rgb(29,107,156), which
      // holds 5.78:1 for white text and 3.72:1 for the accent at 60px.
      background:
        radial-gradient(85rem 38rem at 14% -12%, rgba(59, 142, 222, 0.28), transparent 60%),
        radial-gradient(65rem 34rem at 88% 6%, rgba(35, 198, 213, 0.18), transparent 62%),
        linear-gradient(160deg, rgba(6, 28, 68, 0.96) 0%, rgba(0, 60, 105, 0.95) 55%, rgba(6, 28, 68, 0.97) 100%),
        url("/assets/images/hero.webp") center/cover;

      // Faint blueprint grid, faded out at the edges so it never fights the copy.
      &::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        background-size: 4.5rem 4.5rem;
        -webkit-mask-image: radial-gradient(72% 62% at 50% 38%, #000 28%, transparent 100%);
        mask-image: radial-gradient(72% 62% at 50% 38%, #000 28%, transparent 100%);
      }

      .cs-container {
        width: 100%;
        max-width: 73.125rem;
        margin: auto;
        text-align: center;
      }

      .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1.05rem;
        margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
        border: 1px solid rgba(239, 180, 63, 0.5);
        border-radius: 2rem;
        // Dark fill rather than a tinted one: amber-on-amber measured 3.45:1,
        // below AA for text this size. Against this it clears 7:1.
        background: rgba(7, 26, 66, 0.55);
        color: #f6c964;
        font-family: "Poppins", Arial, sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .hero-eyebrow::before {
        content: "";
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 50%;
        background: #efb43f;
        box-shadow: 0 0 0 0.25rem rgba(239, 180, 63, 0.2);
      }

      h1 {
        font-size: clamp(2.25rem, 5.5vw, 3.75rem);
        line-height: 1.08em;
        letter-spacing: -0.03em;
        max-width: 22ch;
        margin: 0 auto 1.25rem;
        color: #fff;
        text-wrap: balance;
      }

      h1 span {
        color: #9ed6ff;
      }

      p {
        font-size: clamp(1.0625rem, 2vw, 1.25rem);
        line-height: 1.6em;
        max-width: 46rem;
        margin: 0 auto;
        color: #fff;
      }

      .cs-button-solid {
        margin-top: clamp(1.75rem, 3vw, 2.25rem);
      }

      .hero-trust {
        list-style: none;
        padding: 0;
        margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem 2rem;
      }

      .hero-trust li {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #fff;
        font-size: 0.9375rem;
        font-weight: 600;
      }

      .hero-trust li::before {
        content: "✓";
        width: 1.25rem;
        height: 1.25rem;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: rgba(134, 200, 255, 0.16);
        color: #86c8ff;
        font-size: 0.7rem;
        font-weight: 700;
      }
    }

    #schedule-main {
      padding: clamp(2.5rem, 6vw, 5rem) 1rem;

      .cs-container {
        width: 100%;
        max-width: 73.125rem;
        margin: auto;
        display: grid;
        gap: clamp(2rem, 5vw, 4rem);
      }

      .cs-media h2,
      #lead-form h2 {
        font-size: clamp(1.5625rem, 3vw, 1.8125rem);
        line-height: 1.3em;
        text-align: center;
        margin: 0 0 1.5rem;
      }

      .cs-video-intro {
        max-width: 34rem;
        margin: -0.75rem auto 1.25rem;
        text-align: center;
        color: #353535;
      }

      .cs-video {
        width: 100%;
        aspect-ratio: 16 / 9;
        background: #111;
        border-radius: 0.5rem;
        overflow: hidden;
        box-shadow: 0 1.25rem 2.5rem rgba(0, 0, 0, 0.18);

        :global(.cs-video-frame) {
          width: 100%;
          height: 100%;
          border: 0;
          display: block;
        }

        .cs-video-placeholder {
          width: 100%;
          height: 100%;
          padding: 0;
          border: 0;
          position: relative;
          display: grid;
          place-items: center;
          overflow: hidden;
          color: #fff;
          background: #111;
          cursor: pointer;

          img {
            width: 100%;
            height: 100%;
            position: absolute;
            inset: 0;
            object-fit: cover;
          }

          span {
            min-height: 3rem;
            padding: 0.8rem 1.1rem;
            border-radius: 0.35rem;
            position: relative;
            display: inline-flex;
            align-items: center;
            color: #fff;
            background: rgba(7, 26, 66, 0.94);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.28);
            font: 700 0.875rem/1 Poppins, Arial, sans-serif;
            letter-spacing: 0.06em;
            text-transform: uppercase;
          }

          &:focus-visible {
            outline: 0.2rem solid var(--primaryLight);
            outline-offset: -0.3rem;
          }
        }
      }

      .cs-brand-card-link {
        display: block;
        border-radius: 0.5rem;

        &:focus-visible {
          outline: 0.2rem solid var(--primary);
          outline-offset: 0.25rem;
        }

        &:hover .cs-brand-card {
          transform: translateY(-0.25rem);
        }
      }

      .cs-brand-card {
        width: min(100%, 28rem);
        height: auto;
        margin: 2rem auto 0;
        display: block;
        border-radius: 0.5rem;
        transition: transform 0.2s ease;
      }

      #lead-form {
        padding: clamp(1.25rem, 3vw, 2rem);
        scroll-margin-top: 9rem;
        border-top: 0.375rem solid var(--primary);
        border-radius: 0.5rem;
        background: #fff;
        box-shadow: 0 1.25rem 3rem rgba(7, 11, 71, 0.12);
        display: grid;
        gap: 1rem;

        .cs-topper {
          text-align: center;
        }

        p {
          text-align: center;
          margin: -0.75rem 0 0.5rem;
          color: #353535;
        }

        .cs-form-outcomes {
          grid-column: 1 / -1;
          padding: 0;
          margin: 0 0 0.25rem;
          display: grid;
          gap: 0.625rem;
        }

        .cs-form-outcomes li {
          list-style: none;
          padding-left: 1.625rem;
          position: relative;
          color: var(--headerColor);
          font-size: 0.95rem;
          line-height: 1.35em;
          font-weight: 700;
        }

        .cs-form-outcomes li::before {
          content: "";
          width: 0.5rem;
          height: 0.5rem;
          border-radius: 50%;
          background: var(--primary);
          position: absolute;
          top: 0.42rem;
          left: 0.25rem;
        }

        label {
          font-weight: 700;
          color: var(--headerColor);
          display: grid;
          gap: 0.375rem;
        }

        input,
        select,
        textarea {
          width: 100%;
          min-height: 3.5rem;
          border: 1px solid #c6ccd6;
          border-radius: 0.375rem;
          padding: 0 1rem;
          font: inherit;
          color: #1a1a1a;
          background: #fff;
        }

        textarea {
          min-height: 7rem;
          padding-top: 1rem;
          resize: vertical;
        }

        .cs-button-solid {
          width: 100%;
          border: 0;
          height: auto;
          min-height: 3.5rem;
          line-height: 1.2em;
          padding: 1rem;
        }

        .cs-form-continue {
          grid-column: 1 / -1;
        }

        .cs-form-step {
          display: grid;
          gap: 1rem;
          grid-column: 1 / -1;
        }

        .cs-form-step[hidden] {
          display: none;
        }

        small {
          text-align: center;
          color: #565b65;
        }
      }
    }

    .schedule-mobile-cta {
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
      z-index: 900;
      min-height: 3.5rem;
      border: 0;
      border-radius: 0.5rem;
      background: var(--primary);
      color: #fff;
      box-shadow: 0 1rem 2rem rgba(7, 11, 71, 0.22);
      font-family: "Poppins", Arial, sans-serif;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0.2s ease;
    }

    .schedule-mobile-cta.is-hidden {
      opacity: 0;
      transform: translateY(1rem);
      visibility: hidden;
      pointer-events: none;
    }

    #schedule-proof {
      padding: var(--sectionPadding);
      background: #f3f3f4;

      .cs-container {
        width: 100%;
        max-width: 73.125rem;
        margin: auto;
      }

      .cs-content {
        text-align: center;
        max-width: 48rem;
        margin: 0 auto clamp(2rem, 4vw, 3rem);
      }

      ul {
        padding: 0;
        margin: 0;
        display: grid;
        gap: 1rem;
      }

      li {
        list-style: none;
        padding: 1.5rem;
        border-left: 0.25rem solid var(--primary);
        background: #fff;
        border-radius: 0.5rem;
      }

      strong {
        font-family: "Poppins", Arial, sans-serif;
        font-size: 1.125rem;
        color: var(--headerColor);
        display: block;
        margin-bottom: 0.5rem;
      }
    }

    #schedule-results {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        max-width: 73.125rem;
        margin: auto;
        text-align: center;
      }

      .cs-copy {
        max-width: 48rem;
        margin: 0 auto 2rem;
      }

      .cs-gallery {
        display: grid;
        justify-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
      }

      img {
        width: 100%;
        max-width: 64rem;
        height: auto;
        border-radius: 0.5rem;
        box-shadow: 0 1rem 2rem rgba(7, 11, 71, 0.12);
      }

      blockquote {
        max-width: 52rem;
        margin: 0 auto 2rem;
        font-size: clamp(1.125rem, 2.5vw, 1.5rem);
        line-height: 1.45em;
        color: var(--headerColor);
        font-weight: 700;
      }

      cite {
        font-size: 1rem;
        font-style: normal;
        color: var(--primary);
        display: block;
        margin-top: 1rem;
      }
    }

    #schedule-faq {
      padding: var(--sectionPadding);
      background: #f3f3f4;

      .cs-container {
        width: 100%;
        max-width: 52rem;
        margin: auto;
        text-align: center;
      }

      .cs-title {
        margin-bottom: 2rem;
      }

      .cs-faq-list {
        display: grid;
        gap: 0.75rem;
        text-align: left;
      }

      details {
        border: 1px solid #d7dce5;
        border-radius: 0.5rem;
        background: #fff;
        box-shadow: 0 0.75rem 1.5rem rgba(7, 11, 71, 0.06);
      }

      summary {
        padding: 1.125rem 3rem 1.125rem 1.25rem;
        color: var(--headerColor);
        cursor: pointer;
        font-family: "Poppins", Arial, sans-serif;
        font-size: 1rem;
        line-height: 1.35em;
        font-weight: 700;
        list-style: none;
        position: relative;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary::after {
        content: "+";
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 50%;
        background: var(--primary);
        color: #fff;
        display: grid;
        place-items: center;
        position: absolute;
        top: 50%;
        right: 1rem;
        transform: translateY(-50%);
        font-size: 1.125rem;
        line-height: 1;
      }

      details[open] summary::after {
        content: "-";
      }

      details p {
        padding: 0 1.25rem 1.25rem;
        margin: -0.25rem 0 0;
        color: #353535;
        line-height: 1.6em;
      }
    }
  }

  @media only screen and (min-width: 48rem) {
    .schedule-mobile-cta {
      display: none;
    }

    #schedule-main {
      #lead-form {
        grid-template-columns: repeat(2, minmax(0, 1fr));

        .cs-topper,
        h2,
        p,
        .cs-form-outcomes,
        .cs-full,
        button,
        small,
        .cs-form-step {
          grid-column: 1 / -1;
        }

        .cs-form-step {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
    }

    #schedule-proof ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #schedule-results .cs-gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media only screen and (min-width: 64rem) {
    #schedule-main {
      .cs-container {
        grid-template-columns: 1fr 0.9fr;
        align-items: start;
      }
    }
  }

  @media only screen and (min-width: 0rem) {
    // Dark mode has to fight two pre-existing global rules in refresh.less:
    //   :43  h1..h6 { color: var(--headerColor) !important }  -> near-black headings
    //   :130 #schedule-main #lead-form { background: rgba(251,252,248,.9) !important }
    //   :196 input, select, textarea { background: #fff !important }
    // Those carry !important and dark.less does not, so every colour below that
    // targets a heading, the form card, or a field needs !important to land.
    // Note also that var(--accent) is NOT usable here: refresh.less:21 defines it
    // as the amber signal (#efb43f) and overrides dark.less:13 (#334756), so the
    // old rules were painting the FAQ cards and form fields amber.
    body.dark-mode {
      #schedule-main,
      #schedule-results {
        background: var(--dark);
      }

      // The brand blue topper (#0b4aa2) sits at 1.62:1 on the dark card.
      // The lighter accent used elsewhere on the site clears 7.5:1.
      #lead-form .cs-topper,
      #schedule-faq .cs-topper {
        color: #86c8ff !important;
      }

      #schedule-main {
        .cs-media h2,
        .cs-video-intro,
        #lead-form h2,
        #lead-form label,
        #lead-form p,
        #lead-form .cs-form-outcomes li {
          color: var(--bodyTextColorWhite) !important;
        }

        #lead-form {
          background: var(--medium) !important;
          border-color: rgba(255, 255, 255, 0.14) !important;
          box-shadow: none !important;

          input,
          select,
          textarea {
            // Was white-on-white: the rule set white text but refresh.less:196
            // forced a #fff background, so typed input was invisible.
            color: var(--bodyTextColorWhite) !important;
            background: var(--dark) !important;
            border-color: rgba(255, 255, 255, 0.22) !important;
          }

          input::placeholder,
          textarea::placeholder {
            color: rgba(255, 255, 255, 0.55) !important;
          }

          small {
            color: var(--bodyTextColorWhite);
            opacity: 0.8;
          }
        }
      }

      #schedule-proof {
        background: var(--medium);

        .cs-title,
        li,
        strong {
          color: var(--bodyTextColorWhite) !important;
        }

        li {
          background: var(--medium);
          border-left-color: var(--primaryLight);
        }
      }

      #schedule-results {
        .cs-title,
        .cs-text,
        blockquote,
        cite {
          color: var(--bodyTextColorWhite) !important;
        }
      }

      #schedule-faq {
        background: var(--medium);

        .cs-title,
        summary,
        details p {
          color: var(--bodyTextColorWhite) !important;
        }

        details {
          background: var(--medium);
          border-color: rgba(255, 255, 255, 0.16);
          box-shadow: none;
        }
      }
    }
  }
</style>

<script>
  const videoPlaceholder = document.querySelector("[data-youtube-id]");
  videoPlaceholder?.addEventListener("click", () => {
    if (!(videoPlaceholder instanceof HTMLButtonElement)) return;
    const videoId = videoPlaceholder.dataset.youtubeId;
    if (!videoId) return;

    const iframe = document.createElement("iframe");
    iframe.className = "cs-video-frame";
    iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
    iframe.title = "Lead Flow Acceleration Session video";
    iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
    iframe.referrerPolicy = "strict-origin-when-cross-origin";
    iframe.allowFullscreen = true;
    videoPlaceholder.replaceWith(iframe);
  });

  const leadForm = document.querySelector("#lead-form");
  const continueButton = leadForm?.querySelector(".cs-form-continue");
  const secondStep = leadForm?.querySelector("[data-step='2']");
  const mobileCta = document.querySelector(".schedule-mobile-cta");

  const showSecondStep = () => {
    if (!(leadForm instanceof HTMLFormElement) || !(secondStep instanceof HTMLElement)) {
      return false;
    }

    const firstStepFields = leadForm.querySelectorAll(
      "input[name='name'], input[name='email'], input[name='phone'], input[name='service-area']",
    );
    const isFirstStepValid = Array.from(firstStepFields).every((field) => {
      return field instanceof HTMLInputElement && field.reportValidity();
    });

    if (!isFirstStepValid) {
      return false;
    }

    secondStep.hidden = false;
    if (continueButton instanceof HTMLElement) {
      continueButton.hidden = true;
    }
    secondStep.scrollIntoView({ behavior: "smooth", block: "nearest" });
    return true;
  };

  continueButton?.addEventListener("click", () => {
    showSecondStep();
  });

  leadForm?.addEventListener("submit", (event) => {
    if (secondStep instanceof HTMLElement && secondStep.hidden) {
      event.preventDefault();
      showSecondStep();
    }
  });

  mobileCta?.addEventListener("click", () => {
    leadForm?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  if (leadForm && mobileCta && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        mobileCta.classList.toggle("is-hidden", entry.isIntersecting);
      },
      { threshold: 0.15 },
    );

    observer.observe(leadForm);
  }
</script>
