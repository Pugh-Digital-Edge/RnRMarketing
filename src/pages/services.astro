---
import BaseLayout from "src/layouts/BaseLayout.astro";
import Articles from "@components/Articles.astro";

// Optimize our landing image and pass it as props to the BaseLayout (for preloading) and Landing (for rendering)
import { getOptimizedImage } from "@libs/utils";
import Landing from "@components/Landing.astro";

// Import images
import landingImage from "@assets/images/landing/ocean-water.jpg";

// Import SVG icons from @assets/images/svg directory
import FAQ from "@components/FAQ.astro";
import CTA from "@components/CTA.astro";
import ServicesDisplay from "@components/ServicesDisplay.astro";
import CaseStudyTeaser from "@components/CaseStudyTeaser.astro";
import MarketingFramework from "@components/MarketingFramework.astro";
import MarketingStartingPoints from "@components/MarketingStartingPoints.astro";
import faqData from "@data/faqData.json";

// Keep commercial terms aligned with the existing visible FAQ and its schema.
const commercialQuestions = ['How much does restoration marketing cost?', 'Do you require long-term contracts?'];
const commercialTerms = commercialQuestions.map(question => faqData.find(faq => faq.question === question)!);

// Optimize the landing image
const optimizedImage = await getOptimizedImage(landingImage);
---

<BaseLayout
title="Restoration Marketing Services"
description="Marketing services for water damage, fire restoration, and mold remediation companies, built around qualified leads and booked jobs."
preloadedImage={optimizedImage}
>
<Landing
    title="Restoration Marketing Services"
    image={optimizedImage}
    isPageHeading
    compact
  />

  <nav class="service-page-nav" aria-label="On this page">
    <a href="#starting-points">Which service fits?</a>
    <a href="#services-1304">All services</a>
    <a href="#service-results">Client results</a>
    <a href="#service-investment">Budget &amp; commitment</a>
  </nav>

  <!-- ============================================ -->
    <!--                  Content                     -->
    <!-- ============================================ -->

    <section id="content-1637">
        <div class="cs-container">
            <div class="cs-content">
                <div class="cs-flex">
                    <h2 class="cs-title">We Package Services That Drive Real Results for Restoration Companies</h2>
                </div>
                <div class="cs-flex">
                    <h3 class="cs-h3">
                        A connected marketing system built to produce and measure qualified restoration leads.
                    </h3>
                    <p class="cs-text">
                        Our core system combines paid search for immediate demand, SEO for lasting visibility, conversion-focused websites, reputation management, and lead tracking. Each part supports the next: attract property owners, earn trust, capture the inquiry, and measure which marketing created it. We work with one restoration company per territory, subject to availability.
                    </p>
                    <a href="/schedule/" class="cs-button-solid">Request Your Free Acceleration Session</a>
                </div>
            </div>  
        </div>
    </section>

  <MarketingStartingPoints />

  <ServicesDisplay showOverviewLink={false} />

  <MarketingFramework
    serviceName="restoration marketing services"
    industryName="restoration"
    path="/services/"
    includeFaq={false}
  />

  <CaseStudyTeaser id="service-results" compact />

  <section id="service-investment" class="service-investment" aria-labelledby="service-investment-title">
    <div class="service-investment__inner">
      <h2 id="service-investment-title">Know the investment before choosing a plan.</h2>
      <div class="service-investment__terms">
        {commercialTerms.map(term => <div><h3>{term.question}</h3><p>{term.answer}</p></div>)}
      </div>
      <p class="service-investment__next">Your session is free. A marketing proposal comes after we review your territory, priorities, and the work involved.</p>
      <a href="/schedule/" class="cs-button-solid">Discuss your market and budget</a>
    </div>
  </section>

    <FAQ />

    <Articles />

    <CTA />

</BaseLayout>

<style lang="less">
 .service-page-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .25rem 2rem; padding: .65rem 1rem; background: #edf2f5; border-bottom: 1px solid #acb9ca; }
 .service-page-nav a { display: inline-flex; align-items: center; min-height: 44px; color: #0b4aa2; font-weight: 700; text-decoration: underline; text-underline-offset: .2em; }
 .service-page-nav a:focus-visible { outline: 3px solid #0b4aa2; outline-offset: 3px; }
 .service-investment { padding: var(--sectionPadding); background: #edf2f5; scroll-margin-top: 7rem; }
 :global(.route-services #services-1304) { scroll-margin-top: 7rem; }
 .service-investment__inner { max-width: 80rem; margin: auto; }
 .service-investment h2 { max-width: 26ch; margin: 0 0 2.5rem; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.12; text-wrap: balance; }
 .service-investment__terms { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; }
 .service-investment h3 { font-size: 1.25rem; margin: 0 0 .75rem; }
 .service-investment p { max-width: 70ch; line-height: 1.75; color: #42516a; }
 .service-investment__next { margin-block: 2rem 1rem; }
 @media (max-width: 47.99rem) { .service-investment__terms { grid-template-columns: 1fr; gap: 1.5rem; } .service-investment h2 { margin-inline: auto; text-align: center; } }
/*-- -------------------------- -->
<---          Content           -->
<--- -------------------------- -*/

/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
    #content-1637 {
        padding: var(--sectionPadding);
        background-color: #111926;
        position: relative;
        z-index: 1;
        
        .cs-container {
            width: 100%;
            max-width: (1280/16rem);
            margin: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            /* 48px - 100px */
            gap: clamp(3rem, 9vw, 6.25rem);
        }

        .cs-content {
            /* set text align to left if content needs to be left aligned */
            text-align: left;
            width: 100%;
            display: flex;
            flex-direction: column;
            /* centers content horizontally, set to flex-start to left align */
            align-items: flex-start;
        }

        .cs-flex {
            max-width: (608/16rem);
        }
    
        .cs-title {
            color: var(--bodyTextColorWhite);
        }

        .cs-h3 {
            font-size: (20/16rem);
            line-height: 1.2em;
            font-weight: 700;
            margin: 0 0 (16/16rem) 0;
            color: var(--bodyTextColorWhite);
        }

        .cs-text {
            margin-bottom: (16/16rem);
            opacity: .8;
            color: var(--bodyTextColorWhite);

            &:last-of-type {
                margin-bottom: (32/16rem);
            }
        }

        .cs-button-solid {
            font-size: (16/16rem);
            /* 46px - 56px */
            line-height: clamp(2.875rem, 5.5vw, 3.5rem);
            text-decoration: none;
	    	font-weight: 700;
	        text-align: center;
            margin: 0;
            color: #fff;
            min-width: (150/16rem);
            padding: 0 (24/16rem);
            background-color: var(--primary);
            display: inline-block;
            position: relative;
            z-index: 1;
            /* prevents padding from adding to the width */
            box-sizing: border-box;

            &:before {
                content: '';
                position: absolute;
                height: 100%;
                width: 0%;
                background: #000;
                opacity: 1;
                top: 0;
                left: 0;
                z-index: -1;
                transition: width .3s;
            }

            &:hover {
                &:before {
                    width: 100%;
                }
            }
        }
    }
}

/* Tablet - 768px */
@media only screen and (min-width: 48rem) {
    #content-1637 {
        &:before {
            height: 63%;
        }
        .cs-content {
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-start;
            gap: (40/16rem);
        }

        .cs-flex {
            width: 50%;
            text-align: left;
            max-width: (608/16rem);
        }

        .cs-title {
            margin: 0;
        }
    }
}
                                
</style>
