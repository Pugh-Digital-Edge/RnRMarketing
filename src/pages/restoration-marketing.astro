---
import BaseLayout from "src/layouts/BaseLayout.astro";
import AdsLandingPage from "@components/AdsLandingPage.astro";
import { offer, programServices } from "@data/offer.js";

const bodyContract = `impeccable:contract 60015ef0
THESIS: A restoration marketer should feel like a protected territory and a founder-led specialist agency, not an interchangeable agency brochure or a one-person consultancy.
OWN-WORLD: Ink-navy territory grid, cobalt fields, chalk form surface, cyan plot lines, mustard conversion control, and gently squared working panels.
STORY: A restoration owner sees exact message match, understands the restoration-only agency system, verifies reported client outcomes, de-risks the call, and requests a founder-led strategy conversation.
FIRST VIEWPORT: A territory briefing fills the screen: oversized query-matched headline left, qualified form right, and 30-minute, zero-prep, founder-led facts at the decision point.
FORM: Territory field briefing, grounded structure 5; seed key 60015ef0; approved comp .impeccable/mocks/restoration-marketing-comp-b.png.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`;

// The page sells one managed program, so these read as inclusions rather than
// a menu a visitor could order from.
const services = programServices;

const proofItems = [
  {
    title: "One company per territory",
    text: "We work with one restoration company per service territory, subject to availability.",
  },
  {
    title: "100% U.S.-based team",
    text: "Your work stays with our U.S.-based team. We do not outsource it.",
  },
  {
    title: "Qualified leads can begin within 72 hours",
    text: "Paid campaigns can begin producing qualified leads within 72 hours of launch. Timing depends on your market, budget, and campaign readiness.",
  },
];

// Figures come from src/data/caseStudies.js. Only the verified numbers are used
// here; the disputed figures flagged in that file are deliberately left off a
// page that carries paid traffic. Every client runs the same program, so the
// inclusions are stated once above the cards rather than per client.
const results = [
  {
    label: "Chicago-area restoration",
    window: "May–July 2026 reporting",
    headline: "LSA leads more than tripled while cost per lead came down",
    metrics: [
      { value: "5 → 18", label: "Local Services Ads leads" },
      { value: "$177.80 → $147.61", label: "LSA cost per lead" },
    ],
  },
  {
    label: "Michigan restoration",
    window: "May–July 2026 reporting",
    headline: "Organic and Google Business Profile traffic doubled in 90 days",
    metrics: [
      { value: "62 → 124", label: "Reported organic sessions" },
      { value: "23 → 46", label: "Google Business Profile website clicks" },
      { value: "12 → 19", label: "Reported calls" },
    ],
  },
  {
    label: "Kentucky mold & water damage",
    window: "May–July 2026 reporting",
    headline: "More calls and more LSA leads as cost per lead fell",
    metrics: [
      { value: "8 → 22", label: "Reported organic calls" },
      { value: "11 → 19", label: "Local Services Ads leads" },
      { value: "$108.54 → $77.79", label: "LSA cost per lead" },
    ],
  },
];

const programPillars = programServices.map(service => service.title);

const programNote = `${offer.name} brings these five areas together. We build and maintain your website, with transfer rights described in your agreement. The reports below show the combined work in three different markets.`;

const heatMap = {
  src: "/assets/images/case-studies/chicago-gbp-heatmap.gif",
  alt: "Animated Google Business Profile rank grid for a water damage restoration company across the Chicago service area, showing ranking positions improving over time",
  caption: "Google Business Profile rankings across a competitive Chicago service area.",
  note: "Each point is a tracked map-pack position on a geographic grid. Green is a top-three position, red is outside the top twenty. This is local SEO and Google Business Profile work compounding over the reporting window, in one of the most competitive restoration markets in the country.",
};
---

<BaseLayout
  title="Full-Service Restoration Marketing for One Company Per Territory"
  description={`${offer.name}: website, paid search, local SEO and Google Business Profile, AI visibility, and lead tracking. Request your ${offer.session}.`}
  dateModified="2026-09-17"
  bodyContract={bodyContract}
  conversionOnly
  noindex
  eagerAnalytics
>
  <AdsLandingPage
    heroTitle="One Team Running Every Part of Your Restoration Marketing."
    heroText={`${offer.name} connects your website, paid search, local SEO and Google Business Profile, AI visibility, and lead tracking. ${offer.territory}`}
    servicesTitle={offer.name}
    servicesIntro={offer.summary}
    services={services}
    resultsTitle="The work behind the system."
    resultsIntro="Every result below came from running the entire program together, not from one service in isolation. Figures are taken from each client's own reporting for the window shown."
    results={results}
    programPillars={programPillars}
    programNote={programNote}
    heatMap={heatMap}
    proofItems={proofItems}
  />
</BaseLayout>
