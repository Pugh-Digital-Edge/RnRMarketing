---
import BaseLayout from "src/layouts/BaseLayout.astro";
import Articles from "@components/Articles.astro";

// Optimize our landing image and pass it as props to the BaseLayout (for preloading) and Landing (for rendering)

// Import images

// Import SVG icons from @assets/images/svg directory
import CTA from "@components/CTA.astro";
import Newsletter from "@components/Newsletter.astro";
import ServiceSchema from "@components/ServiceSchema.astro";
import MarketingFramework from "@components/MarketingFramework.astro";
import ServiceDepth from "@components/ServiceDepth.astro";
import ServiceHero from "@components/ServiceHero.astro";
import CaseStudyTeaser from "@components/CaseStudyTeaser.astro";


---

<BaseLayout
 title="Retargeting for Restoration Companies"
 description="Re-engage qualified restoration website visitors with practical retargeting campaigns that keep your company visible while they compare options."
>
<ServiceSchema
  name="Retargeting for Restoration Companies"
  description="Retargeting campaigns that keep your restoration company visible to previous website visitors across the web, so you stay top of mind while property owners research and compare contractors."
  path="/services/retargeting/"
  serviceType="Display Advertising"
/>
  <ServiceHero service="retargeting" />

   <ServiceDepth service="retargeting" />
   <MarketingFramework
     serviceName="Retargeting"
     industryName="restoration"
     path="/services/retargeting/"
     includeFaq={false}
   />
   <CaseStudyTeaser compact />
   <CTA />
   <Articles />
   <Newsletter />
</BaseLayout>
