---
import BaseLayout from "src/layouts/BaseLayout.astro";
import Articles from "@components/Articles.astro";

// Optimize our landing image and pass it as props to the BaseLayout (for preloading) and Landing (for rendering)

// Import images

// Import SVG icons from @assets/images/svg directory
import CTA from "@components/CTA.astro";
import Newsletter from "@components/Newsletter.astro";
import ServiceSchema from "@components/ServiceSchema.astro";
import MarketingFramework from "@components/MarketingFramework.astro";
import ServiceDepth from "@components/ServiceDepth.astro";
import ServiceHero from "@components/ServiceHero.astro";
import CaseStudyTeaser from "@components/CaseStudyTeaser.astro";

---

<BaseLayout
  title="Social Media Management for Restoration Companies"
  description="Social media management for restoration companies that turns project proof, team expertise, and local updates into a consistent trust-building program."
>
<ServiceSchema
  name="Social Media Management for Restoration Companies"
  description="Social media management for restoration companies that showcases completed projects, customer testimonials, and professional certifications to build trust with property owners and insurance partners."
  path="/services/social-media-marketing/"
  serviceType="Social Media Marketing"
/>
  <ServiceHero service="social-media-marketing" />

    <ServiceDepth service="social-media-marketing" />
    <MarketingFramework
      serviceName="Social Media Marketing"
      industryName="restoration"
      path="/services/social-media-marketing/"
      includeFaq={false}
    />
    <CaseStudyTeaser compact />
    <CTA />
    <Articles />
    <Newsletter />
</BaseLayout>
