---
import BaseLayout from "src/layouts/BaseLayout.astro";
import Articles from "@components/Articles.astro";

// Optimize our landing image and pass it as props to the BaseLayout (for preloading) and Landing (for rendering)

// Import images

import CTA from "@components/CTA.astro";
import FAQ from "@components/FAQ.astro";
import Newsletter from "@components/Newsletter.astro";
import ServiceSchema from "@components/ServiceSchema.astro";
import MarketingFramework from "@components/MarketingFramework.astro";
import ServiceDepth from "@components/ServiceDepth.astro";
import ServiceHero from "@components/ServiceHero.astro";
import CaseStudyTeaser from "@components/CaseStudyTeaser.astro";

---

<BaseLayout
  title="Restoration Reputation Management"
  description="Protect and grow your restoration company's online reputation. We automate review collection, monitor mentions, and help you maintain 5-star ratings across Google, Facebook, and industry platforms."
>
<ServiceSchema
  name="Reputation Management for Restoration Companies"
  description="Review generation, monitoring, and response management for restoration companies across Google, Facebook, and industry platforms, building the trust property owners and insurance partners look for."
  path="/services/reputation-management/"
  serviceType="Reputation Management"
/>
  <ServiceHero service="reputation-management" />

    <ServiceDepth service="reputation-management" />
    <MarketingFramework
      serviceName="Reputation Management"
      industryName="restoration"
      path="/services/reputation-management/"
      includeFaq={false}
    />
    <FAQ />  
    <CaseStudyTeaser compact />
    <CTA />
    <Articles />
    <Newsletter />
</BaseLayout>
