---
import BaseLayout from "src/layouts/BaseLayout.astro";
import Articles from "@components/Articles.astro";

// Optimize our landing image and pass it as props to the BaseLayout (for preloading) and Landing (for rendering)

// Import images

// Import SVG icons from @assets/images/svg directory
import CTA from "@components/CTA.astro";
import FAQ from "@components/FAQ.astro";
import Newsletter from "@components/Newsletter.astro";
import CaseStudyTeaser from "@components/CaseStudyTeaser.astro";
import ServiceSchema from "@components/ServiceSchema.astro";
import MarketingFramework from "@components/MarketingFramework.astro";
import ServiceDepth from "@components/ServiceDepth.astro";
import ServiceHero from "@components/ServiceHero.astro";

---

<BaseLayout
title="Restoration Lead Tracking & Analytics"
description="See how data-driven marketing decisions can maximize your restoration company's ROI." >


<ServiceSchema
  name="Lead Tracking & Analytics for Restoration Companies"
  description="Call, form, and chat tracking for restoration companies, with reporting on lead quality, conversion rate, and cost per acquisition so you can see which marketing channels produce booked jobs."
  path="/services/lead-tracking/"
  serviceType="Marketing Analytics"
/>
  <ServiceHero service="lead-tracking" />

    <ServiceDepth service="lead-tracking" />
    <MarketingFramework
      serviceName="Lead Tracking & Analytics"
      industryName="restoration"
      path="/services/lead-tracking/"
      includeFaq={false}
    />
    <FAQ />  
    <CaseStudyTeaser compact />
    <CTA />
    <Articles />
    <Newsletter />
  </BaseLayout>
