---
import BaseLayout from "src/layouts/BaseLayout.astro";
import Articles from "@components/Articles.astro";


// Import images
import CTA from "@components/CTA.astro";
import FAQ from "@components/FAQ.astro";
import Newsletter from "@components/Newsletter.astro";
import CaseStudyTeaser from "@components/CaseStudyTeaser.astro";
import ServiceSchema from "@components/ServiceSchema.astro";
import MarketingFramework from "@components/MarketingFramework.astro";
import ServiceDepth from "@components/ServiceDepth.astro";
import ServiceHero from "@components/ServiceHero.astro";


---

<BaseLayout
  title="Restoration Paid Digital Advertising"
  description="Discover how strategic PPC and LSA campaigns can help your restoration company capture emergency leads and grow your business."
>

<ServiceSchema
  name="PPC & Local Service Ads for Restoration Companies"
  description="Google Ads and Local Service Ads campaigns built for emergency restoration, including 24/7 emergency targeting, weather-triggered campaigns, and location-specific bidding for water, fire, and mold damage leads."
  path="/services/ppc/"
  serviceType="Pay Per Click Advertising"
/>
  <ServiceHero service="ppc" />


    <ServiceDepth service="ppc" />
    <MarketingFramework
      serviceName="PPC and Local Service Ads"
      industryName="restoration"
      path="/services/ppc/"
      includeFaq={false}
    />
    <FAQ />  
    <CaseStudyTeaser compact />
    <CTA />
    <Articles />
    <Newsletter />

</BaseLayout>
