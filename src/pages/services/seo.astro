---
import BaseLayout from "src/layouts/BaseLayout.astro";
import Articles from "@components/Articles.astro";
import CTA from "@components/CTA.astro";
import FAQ from "@components/FAQ.astro";
import Newsletter from "@components/Newsletter.astro";
import CaseStudyTeaser from "@components/CaseStudyTeaser.astro";
import MarketingFramework from "@components/MarketingFramework.astro";
import ServiceDepth from "@components/ServiceDepth.astro";
---

<BaseLayout
  title="SEO for Restoration Companies"
  description="Restoration SEO services built to improve local visibility, capture emergency searches, and connect organic performance to qualified calls."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "SEO for Restoration Companies",
    "description": "Restoration-focused SEO for water damage, fire restoration, mold remediation, and other emergency services, including local SEO, content, technical optimization, and lead tracking.",
    "provider": {
      "@type": "Organization",
      "@id": "https://remediationrestorationmarketing.com/#localbusiness",
      "name": "Remediation & Restoration Marketing"
    },
    "areaServed": { "@type": "Country", "name": "United States" },
    "serviceType": "Search Engine Optimization",
    "url": "https://remediationrestorationmarketing.com/services/seo/",
    "offers": {
      "@type": "Offer",
      "url": "https://remediationrestorationmarketing.com/services/seo/"
    }
  })} />

  <section class="seo-hero">
    <div class="seo-hero__grid" aria-hidden="true"></div>
    <div class="seo-hero__inner">
      <div class="seo-hero__copy">
        <h1>SEO for restoration companies that need to be found before the next call is gone</h1>
        <p class="seo-hero__answer"><strong>Restoration SEO</strong> improves a contractor’s visibility for urgent local searches such as water damage, fire restoration, and mold remediation. It connects technically sound service pages, Google Business Profile optimization, local authority, and call tracking so visibility can be measured against real inquiries.</p>
        <div class="seo-hero__actions">
          <a class="seo-hero__primary" href="/contact/">Request an SEO assessment</a>
          <a class="seo-hero__secondary" href="#restoration-seo-system">See how the system works</a>
        </div>
      </div>

      <aside class="seo-proof" aria-label="Recent restoration SEO outcomes">
        <h2>Recent reported outcomes</h2>
        <div class="seo-proof__metrics">
          <p><strong>79.7%</strong><span>month-over-month organic-session growth</span></p>
          <p><strong>220%</strong><span>reported increase in organic calls</span></p>
        </div>
        <p class="seo-proof__note">Strongest improvements observed in July 2026 client reporting. Individual account results are shown without exposing client volume. Outcomes are not guarantees.</p>
      </aside>
    </div>

    <nav class="seo-hero__nav" aria-label="On this page">
      <a href="#restoration-seo-system">What we optimize</a>
      <a href="#restoration-seo-process">Our process</a>
      <a href="#restoration-seo-evidence">Client evidence</a>
      <a href="#restoration-seo-faqs">Questions answered</a>
    </nav>
  </section>

  <ServiceDepth service="seo" />
  <MarketingFramework
    serviceName="Search Engine Optimization"
    industryName="restoration"
    path="/services/seo/"
    includeFaq={false}
  />
  <FAQ />
  <CaseStudyTeaser compact />
  <CTA />
  <Articles />
  <Newsletter />
</BaseLayout>

<style lang="less">
  .seo-hero {
    color: #fbfcf8;
    background: #071a42;
    overflow: hidden;
    position: relative;
  }

  .seo-hero__grid {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.22) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.22) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  .seo-hero__inner,
  .seo-hero__nav {
    width: min(100% - 2rem, 80rem);
    margin-inline: auto;
    position: relative;
  }

  .seo-hero__inner {
    min-height: min(34rem, calc(100svh - 8rem));
    padding: clamp(3rem, 6vw, 5rem) 0;
    box-sizing: border-box;
    display: grid;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .seo-hero__copy {
    max-width: 47rem;
  }

  .seo-hero h1 {
    max-width: 14ch;
    margin: 0 0 1.5rem;
    color: #fff;
    font-size: clamp(2.7rem, 5vw, 4.8rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .seo-hero__answer {
    max-width: 68ch;
    margin: 0;
    color: #dce8f8;
    font-size: clamp(1rem, 1.5vw, 1.16rem);
    line-height: 1.7;
  }

  .seo-hero__answer strong {
    color: #fff;
  }

  .seo-hero__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .seo-hero__primary,
  .seo-hero__secondary {
    min-height: 3.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    text-decoration: none;
  }

  .seo-hero__primary {
    padding: 0.9rem 1.3rem;
    border-radius: 0.35rem;
    color: #071a42;
    background: #efb43f;
    box-shadow: 0 0.6rem 1.5rem rgba(0, 0, 0, 0.2);
  }

  .seo-hero__secondary {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: #23c6d5;
    text-underline-offset: 0.4rem;
  }

  .seo-hero a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  .seo-proof {
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 0.65rem;
    background: rgba(11, 74, 162, 0.42);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .seo-proof h2 {
    margin: 0 0 1.5rem;
    color: #fff;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .seo-proof__metrics {
    display: grid;
    gap: 1.25rem;
  }

  .seo-proof__metrics p {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .seo-proof__metrics strong {
    color: #23c6d5;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1;
  }

  .seo-proof__metrics span {
    color: #eef6ff;
    line-height: 1.45;
  }

  .seo-proof__note {
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    color: #cbd9ec;
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .seo-hero__nav {
    padding: 1rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    display: flex;
    gap: 0.75rem 1.5rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .seo-hero__nav a {
    flex: none;
    color: #dce8f8;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .seo-hero__primary:hover {
    background: #23c6d5;
    transform: translateY(-2px);
  }

  .seo-hero__secondary:hover,
  .seo-hero__nav a:hover {
    color: #23c6d5;
  }

  @media (min-width: 64rem) {
    .seo-hero__inner {
      grid-template-columns: minmax(0, 1.65fr) minmax(19rem, 0.75fr);
    }
  }

  @media (max-width: 47.99rem) {
    .seo-hero__inner {
      min-height: 0;
      padding: 2.75rem 0;
      gap: 2rem;
    }

    .seo-hero h1 {
      font-size: clamp(2.4rem, 11vw, 3.25rem);
    }

    .seo-proof {
      padding: 1.25rem;
    }

    .seo-proof__metrics {
      grid-template-columns: 1fr 1fr;
    }

    .seo-proof__metrics p {
      display: block;
    }

    .seo-proof__metrics strong,
    .seo-proof__metrics span {
      display: block;
    }

    .seo-proof__metrics span {
      margin-top: 0.45rem;
      font-size: 0.85rem;
    }

    .seo-hero__actions,
    .seo-hero__primary {
      width: 100%;
    }

    .seo-hero__secondary {
      justify-content: flex-start;
    }
  }
</style>
