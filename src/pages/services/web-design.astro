---
import BaseLayout from "src/layouts/BaseLayout.astro";
import Articles from "@components/Articles.astro";

// Optimize our landing image and pass it as props to the BaseLayout (for preloading) and Landing (for rendering)

// Import images

// Import SVG icons from @assets/images/svg directory
import CTA from "@components/CTA.astro";
import Newsletter from "@components/Newsletter.astro";
import CaseStudyTeaser from "@components/CaseStudyTeaser.astro";
import ServiceSchema from "@components/ServiceSchema.astro";
import MarketingFramework from "@components/MarketingFramework.astro";
import ServiceDepth from "@components/ServiceDepth.astro";
import ServiceHero from "@components/ServiceHero.astro";


---

<BaseLayout
  title="Web Design for Restoration Companies"
  description="Restoration web design built to help urgent visitors find the right service, trust your team, and contact you quickly from any device."
>
<ServiceSchema
  name="Web Design for Restoration Companies"
  description="Fast, mobile-first restoration websites built to convert emergency calls, featuring tap-to-call buttons, service area maps, before/after galleries, and certification displays."
  path="/services/web-design/"
  serviceType="Web Design"
/>
  <ServiceHero service="web-design" />

    <ServiceDepth service="web-design" />
    <MarketingFramework
      serviceName="Restoration Web Design"
      industryName="restoration"
      path="/services/web-design/"
      includeFaq={false}
    />
    <CaseStudyTeaser compact />
    <CTA />
    <Articles />
    <Newsletter />
</BaseLayout>
