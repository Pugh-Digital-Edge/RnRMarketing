---
import BaseLayout from "src/layouts/BaseLayout.astro";
import Articles from "@components/Articles.astro";

// Optimize our landing image and pass it as props to the BaseLayout (for preloading) and Landing (for rendering)

// Import images

// Import SVG icons from @assets/images/svg directory
import CTA from "@components/CTA.astro";
import FAQ from "@components/FAQ.astro";
import Newsletter from "@components/Newsletter.astro";
import ServiceSchema from "@components/ServiceSchema.astro";
import MarketingFramework from "@components/MarketingFramework.astro";
import ServiceDepth from "@components/ServiceDepth.astro";
import ServiceHero from "@components/ServiceHero.astro";
import CaseStudyTeaser from "@components/CaseStudyTeaser.astro";


---

<BaseLayout
  title="Restoration Social Media Advertising"
  description="Convert emergency water, fire, and mold damage leads with targeted Facebook and Instagram ads."
>
<ServiceSchema
  name="Social Media Advertising for Restoration Companies"
  description="Facebook and Instagram ad campaigns for emergency restoration, featuring rapid campaign activation, precise location targeting, and weather-event targeting to reach property owners when disaster strikes."
  path="/services/social-media-advertising/"
  serviceType="Social Media Advertising"
/>
  <ServiceHero service="social-media-advertising" />

    <ServiceDepth service="social-media-advertising" />
    <MarketingFramework
      serviceName="Facebook & Instagram Advertising"
      industryName="restoration"
      path="/services/social-media-advertising/"
      includeFaq={false}
    />
    <FAQ />  
    <CaseStudyTeaser compact />
    <CTA />
    <Articles />
    <Newsletter />
</BaseLayout>
