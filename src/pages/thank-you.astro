---
import { offer } from "@data/offer.js";
import BaseLayout from "src/layouts/BaseLayout.astro";
import { getOptimizedImage } from "@libs/utils";
import heroImage from "@assets/images/landing/blue-abstract.jpeg";

const preloadedImage = await getOptimizedImage(heroImage);
---

<BaseLayout
  title="Lead Flow Acceleration Session Request Received"
  description={`Your ${offer.session} request has been received. Choose a time for your 30-minute session with Matt.`}
  preloadedImage={preloadedImage}
  noindex
  eagerAnalytics
>
  <script>
    import { consumeAcceptedRequest } from "../scripts/lead-request";
    consumeAcceptedRequest();
  </script>
  <script is:inline>
    (() => {
      let shouldTrackLead = false;

      try {
        shouldTrackLead = window.sessionStorage.getItem('schedule_lead_submission_pending') === '1';
        if (shouldTrackLead) {
          window.sessionStorage.removeItem('schedule_lead_submission_pending');
        }
      } catch {
        // Storage can be unavailable in privacy-restricted browsers.
      }

      if (window.rrTrackingDisabled || !shouldTrackLead || typeof window.gtag !== 'function') {
        return;
      }

      let leadUserData = {};

      try {
        leadUserData = JSON.parse(window.sessionStorage.getItem('schedule_lead_user_data')) || {};
        window.sessionStorage.removeItem('schedule_lead_user_data');
      } catch {
        // Storage can be unavailable in privacy-restricted browsers.
      }

      // Older paid-page pending flags are intents, not accepted requests.
      if (typeof leadUserData.landing_page === 'string' && leadUserData.landing_page.replace(/\/$/, '') === '/restoration-marketing') return;
      const attribution = window.rrAttribution || {};

      window.gtag('event', 'generate_lead', {
        send_to: window.rrTracking?.ga4Id,
        form_id: 'lead-form',
        form_page: leadUserData.landing_page || '',
        ...(leadUserData.landing_page === '/restoration-marketing/' ? { funnel_version: 'restoration_v1', form_step: 2 } : {}),
        event_category: 'conversion',
        form_name: 'Schedule Lead Form',
        lead_type: 'restoration_strategy_call',
        landing_page: leadUserData.landing_page || attribution.landing_page || '',
        lead_scope: leadUserData.lead_scope || '',
        lead_budget: leadUserData.lead_budget || '',
        gclid: attribution.gclid || '',
        page_location: window.location.href,
      });

      const trackingConfig = window.rrTracking || {};

      if (trackingConfig.googleAdsId && trackingConfig.leadConversionLabel) {
        window.gtag('event', 'conversion', {
          send_to: `${trackingConfig.googleAdsId}/${trackingConfig.leadConversionLabel}`,
        });
      }
    })();
  </script>
  <main class="thank-you">
    <div class="thank-you__content">
      <p class="cs-topper">YOUR TERRITORY PLAN</p>
      <h1>Choose a time to discuss your territory.</h1>
      <p>
        Next, book your 30-minute {offer.session} with Matt below and it is locked in
        straight away, no back-and-forth email. Nothing to prepare, just bring your questions.
      </p>
    </div>

    <div class="thank-you__scheduler">
      <!-- Opening this scheduler is not evidence of a booked appointment. -->
      <iframe
        src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ0ZohPTCbsjXJVYM2p94A87G46TCsjvi-5Oj3cGo3PGwRfQhrqZIZ-Q9BTNS4jlHWSPKArREwSH?gv=true"
        title={`Book your ${offer.session} with Matt Pugh`}
        width="100%"
        height="600"
        frameborder="0"
        style="border: 0"
      ></iframe>
    </div>

    <div class="thank-you__content thank-you__footnote">
      <p><a href={offer.checklistDownload} download>Download your AI visibility checklist</a>. Bring it to your session if you like; nothing to prepare.</p>
      <p>
        Prefer not to book now? After submitting your request, Matt will review your service territory and reach out.
        In the meantime, see the reported client results behind the {offer.name}.
      </p>
      <a href="/case-studies/" class="cs-button-solid">See Client Results</a>
    </div>
  </main>
</BaseLayout>

<style lang="less">
  .thank-you {
    min-height: 65vh;
    padding: clamp(9rem, 16vw, 13rem) 1rem var(--sectionPadding);
    background: var(--surfaceMuted);
  }

  .thank-you__content {
    width: 100%;
    max-width: 44rem;
    margin: auto;
    text-align: center;
  }

  .thank-you h1 {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.08;
    margin-bottom: 1rem;
  }

  .thank-you p:not(.cs-topper) {
    margin-bottom: 2rem;
  }

  .thank-you__scheduler {
    width: 100%;
    max-width: 56rem;
    margin: 0 auto 3rem;
    padding: 0.5rem;
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: var(--shadowS);
  }

  .thank-you__scheduler iframe {
    width: 100%;
    min-height: 37.5rem;
    border: 0;
    border-radius: 0.75rem;
    display: block;
  }

  .thank-you__footnote {
    padding-top: 2rem;
    border-top: 1px solid var(--borderColor);
  }

  .thank-you__footnote p {
    font-size: 0.95rem;
  }
</style>
