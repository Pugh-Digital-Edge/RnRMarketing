---
import BaseLayout from "src/layouts/BaseLayout.astro";
import { bookingUrl } from "@data/booking.js";
---

<BaseLayout
  title="Restoration Website Audit Preview | R&R Marketing"
  description="Explore a fictional restoration website audit with page evidence, an HTML signal score, and three practical next steps. Live scanning is not available yet."
  noindex
>
  <script is:inline slot="before-tracking">
    (() => {
      const fragment = new URLSearchParams(window.location.hash.slice(1));
      if (!fragment.has('report') && !fragment.has('token')) return;
      const jobId = fragment.get('report') || '';
      const accessToken = fragment.get('token') || '';
      // Remove private link credentials before analytics or third-party scripts run.
      window.history.replaceState(window.history.state, '', window.location.pathname + window.location.search);
      if (/^[a-zA-Z0-9_-]{1,160}$/.test(jobId) && /^[a-zA-Z0-9._-]{1,1200}$/.test(accessToken)) {
        window.rrAuditReportLink = { jobId, accessToken };
      }
    })();
  </script>
  <div class="wa" data-website-audit>
    <div class="wa-local-banner" data-audit-local-banner hidden role="status"><div class="wa-container"><strong>Local preview only.</strong> The scanner reads the included fixture websites. Reports are saved to a local outbox; no email is sent and no HubSpot contact is created. Public website scanning is unavailable in this mode.</div></div>
    <section class="wa-hero" aria-labelledby="audit-title">
      <div class="wa-container wa-hero-grid">
        <div class="wa-intro">
          <p class="wa-eyebrow"><span aria-hidden="true"></span> Restoration website audit</p>
          <h1 id="audit-title">Find the gaps.<br />Make the next<br /><em>call easier.</em></h1>
          <p class="wa-lede" data-audit-lede>Explore a fictional restoration website report to see how HTML evidence can point to clearer next steps for property owners.</p>
          <ul class="wa-benefits" aria-label="What the audit report includes">
            <li><span aria-hidden="true">01</span> A score with the evidence behind it</li>
            <li><span aria-hidden="true">02</span> Checks built around restoration services</li>
            <li><span aria-hidden="true">03</span> Three practical fixes to start with</li>
          </ul>
          <p class="wa-intro-note" data-audit-intro-note>Preview only. No website is scanned and no email is collected.</p>
        </div>

        <div class="wa-scan-panel">
          <div class="wa-panel-top"><span class="wa-eyebrow" data-audit-panel-eyebrow>Website audit / preview</span><span class="wa-panel-mark" aria-hidden="true">R&amp;R</span></div>
          <h2 data-audit-form-title>Preview the website audit.</h2>
          <p class="wa-panel-copy" data-audit-form-copy>Explore a fictional report. Live scanning and email delivery are not available yet.</p>
          <p id="audit-availability" class="wa-setup" data-audit-availability role="status">Preview only. No website will be scanned and no email address is collected. Live scanning and email delivery are not available yet.</p>
          <form data-audit-form aria-describedby="audit-availability">
            <div class="wa-field" data-audit-fixture-field hidden><label for="audit-fixture">Preview website</label><select id="audit-fixture" data-audit-fixture aria-describedby="audit-fixture-help"></select><p id="audit-fixture-help" class="wa-help">Choose an included website. Its actual fixture HTML will be scanned locally.</p></div>
            <div class="wa-field">
              <label for="audit-url" data-audit-url-label>Website homepage</label>
              <input id="audit-url" name="url" type="text" inputmode="url" autocomplete="url" placeholder="https://yourcompany.com" required maxlength="2048" aria-describedby="audit-url-help" disabled />
              <p id="audit-url-help" class="wa-help">These fields become available when scanning is enabled.</p>
            </div>
            <div class="wa-field">
              <label for="audit-service">Primary restoration service</label>
              <select id="audit-service" name="service" required disabled>
                <option value="">Choose a service</option>
                <option value="water damage restoration">Water damage restoration</option>
                <option value="fire damage restoration">Fire damage restoration</option>
                <option value="mold remediation">Mold remediation</option>
                <option value="storm damage restoration">Storm damage restoration</option>
                <option value="sewage cleanup">Sewage cleanup</option>
                <option value="biohazard cleanup">Biohazard cleanup</option>
              </select>
            </div>
            <div class="wa-field">
              <label for="audit-area">Primary service area</label>
              <input id="audit-area" name="area" type="text" autocomplete="address-level2" placeholder="City and state, e.g. Tampa, FL" required minlength="2" maxlength="120" disabled />
            </div>
            <div data-audit-bot="scan" class="wa-bot" hidden></div>
            <button class="wa-button wa-button-primary" type="submit" data-audit-submit disabled><span>Live scanning unavailable</span><svg class="wa-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></button>
            <p class="wa-form-error" data-audit-error role="alert" hidden></p>
          </form>
          <div class="wa-sample-action"><span>See the report format.</span><button type="button" data-audit-sample>Explore the fictional sample <span aria-hidden="true">→</span></button></div>
          <noscript><p class="wa-setup">JavaScript is needed to open the fictional sample report. Live scanning and email delivery are unavailable. You can still <a href={bookingUrl}>book a free strategy call</a>.</p></noscript>
        </div>
      </div>
      <div class="wa-container wa-scope-line"><span>PUBLIC HTML SIGNALS</span><p>Lead capture <i aria-hidden="true">/</i> Service relevance <i aria-hidden="true">/</i> Local signals <i aria-hidden="true">/</i> Technical basics</p></div>
    </section>

    <section class="wa-progress-section wa-container" data-audit-progress hidden aria-labelledby="audit-progress-title" aria-busy="true">
      <div class="wa-progress-icon" aria-hidden="true"></div>
      <div><p class="wa-eyebrow">Website check</p><h2 id="audit-progress-title">Your scan is queued.</h2><p data-audit-progress-text role="status" aria-live="polite">Waiting for the scanner to start.</p></div>
      <button type="button" class="wa-text-button" data-audit-stop>Stop waiting</button>
    </section>
    <div class="wa-container wa-resume" data-audit-resume hidden><p data-audit-resume-text role="status"></p><button type="button" class="wa-button wa-button-secondary" data-audit-check-again>Check scan status again</button></div>

    <section class="wa-report wa-container" data-audit-report hidden aria-labelledby="audit-report-title">
      <div class="wa-report-heading">
        <div><p class="wa-eyebrow" data-report-kind></p><h2 id="audit-report-title" tabindex="-1">Sample website snapshot.</h2></div>
        <p class="wa-report-context" data-report-context></p>
      </div>
      <p class="wa-demo-note" data-report-demo hidden><strong>Fictional sample.</strong> This illustrates the report format for example.test. It is not a scan of the website entered above.</p>
      <p class="wa-demo-note" data-report-local hidden><strong>Local fixture scan.</strong> These findings come from the included website’s HTML, read by the local scanner. They do not describe a public business. No external email or CRM service is used.</p>
      <div class="wa-overview">
        <div class="wa-score-panel"><p class="wa-eyebrow">Website signal score</p><p class="wa-score"><strong data-report-score>—</strong><span>/ 100</span></p><p data-report-score-caption></p><p class="wa-score-note">Based on checked HTML signals. Unknown checks do not count toward the score. This is not a ranking or lead forecast.</p></div>
        <div class="wa-categories" data-report-categories></div>
      </div>
      <div class="wa-section-heading"><div><p class="wa-eyebrow">Your next moves</p><h3>Start with these three fixes.</h3></div><p>Each recommendation points back to something the report found.</p></div>
      <ol class="wa-fixes" data-report-fixes></ol>
      <div class="wa-section-heading wa-checks-heading"><div><p class="wa-eyebrow">Show your work</p><h3>The checks behind your score.</h3></div><p>Open any check to see its evidence and suggested action.</p></div>
      <div class="wa-checks" data-report-checks></div>
      <details class="wa-scope-details"><summary>Pages checked &amp; report limitations</summary><div class="wa-scope-body"><h4>Page coverage</h4><ul data-report-pages></ul><h4>What this report can tell you</h4><ul data-report-limitations></ul></div></details>

      <div class="wa-report-bottom">
        <section class="wa-email-panel" aria-labelledby="audit-email-title">
          <p class="wa-eyebrow">Report access</p><h3 id="audit-email-title">About report delivery.</h3>
          <p data-report-delivery-note>Report delivery is unavailable for the sample. No email address is needed to explore it.</p>
          <form data-audit-email-form hidden>
            <div class="wa-field"><label for="audit-email" data-audit-email-label>Email address</label><input id="audit-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
            <label class="wa-consent" for="audit-marketing" data-audit-marketing-field><input id="audit-marketing" name="marketingConsent" type="checkbox" /><span>I’d also like occasional restoration marketing tips and offers. Optional.</span></label>
            <p class="wa-help" data-audit-email-privacy>Requesting your report does not subscribe you to marketing. We use your email to deliver this report. <a href="/privacy/">Privacy policy</a></p>
            <p class="wa-help" data-audit-local-delivery-help hidden>Use a test address, such as owner@example.test. It is recorded only in the local outbox to exercise the report workflow. No email is sent, no CRM contact is created, and no marketing is requested.</p>
            <div data-audit-bot="report" class="wa-bot" hidden></div>
            <button type="submit" class="wa-button wa-button-primary" data-audit-email-submit disabled><span data-audit-email-button-label>Email my report</span><span aria-hidden="true">→</span></button>
          </form>
          <p class="wa-delivery-status" data-audit-email-status role="status" aria-live="polite"></p>
          <p class="wa-form-error" data-audit-email-error role="alert" hidden></p>
        </section>
        <aside class="wa-call-panel" aria-labelledby="audit-call-title"><p class="wa-eyebrow">Put the findings to work</p><h3 id="audit-call-title">A clearer plan for your next move.</h3><p>Talk through your website, service area, and lead flow with Matt Pugh. Bring the report and your questions.</p><a href={bookingUrl} class="wa-button wa-button-light" data-booking-placement="audit_report">Book a free strategy call <svg class="wa-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a><p class="wa-call-note">30 minutes · Google Meet · Nothing to prepare</p></aside>
      </div>
    </section>

    <section class="wa-method wa-container" aria-labelledby="audit-method-title">
      <div><p class="wa-eyebrow">A useful first look</p><h2 id="audit-method-title">Clarity before<br />a bigger commitment.</h2><p>Use the report to spot specific opportunities on your own website, then decide what deserves a closer look.</p></div>
      <div class="wa-method-items">
        <div><span aria-hidden="true">01 /</span><h3>Public pages. Specific evidence.</h3><p>The check reads a limited set of public pages. Findings include the page and HTML signal behind them.</p></div>
        <div><span aria-hidden="true">02 /</span><h3>Unknown means unknown.</h3><p>Blocked or unavailable pages are identified. Missing evidence is never presented as a confirmed defect.</p></div>
        <div><span aria-hidden="true">03 /</span><h3>A starting point, with limits.</h3><p>This is an automated HTML review. It does not visually inspect layouts, test real devices, verify rankings, or measure Core Web Vitals.</p></div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { setupWebsiteAudit } from "@scripts/website-audit";
  import { setupBookingClicks } from "@scripts/booking-clicks";
  setupWebsiteAudit();
  setupBookingClicks();
</script>

<style is:global>
  .wa { --wa-ink:#071a42; --wa-blue:#0b4aa2; --wa-paper:#fbfcf8; --wa-muted:#edf2f5; --wa-line:rgba(8,22,50,.17); background:var(--wa-paper); color:var(--wa-ink); font-family:Poppins,Arial,sans-serif; padding-top:8.5rem; }
  .wa *, .wa *::before, .wa *::after { box-sizing:border-box; }
  .wa [hidden] { display:none !important; }
  .wa p,.wa li,.wa a { color:inherit; }
  .wa h1,.wa h2,.wa h3,.wa h4,.wa p,.wa ul,.wa ol { margin:0; }
  .wa button,.wa input,.wa select { font:inherit; }
  .wa button,.wa a,.wa input,.wa select,.wa summary { -webkit-tap-highlight-color:transparent; }
  .wa a:focus-visible,.wa button:focus-visible,.wa summary:focus-visible { outline:3px solid #0b4aa2; outline-offset:5px; }
  .wa-container { width:min(1240px,calc(100% - 3rem)); margin-inline:auto; }
  .wa-local-banner { background:#fff1cb; border-bottom:1px solid #d4b970; padding:1rem 0; font-size:.78rem; line-height:1.85; }
  .wa-local-banner strong { margin-right:.3rem; }
  .wa-field input[readonly] { background:#edf2f5; color:#42516a; }
  .wa-field input:disabled,.wa-field select:disabled { background:#edf2f5; color:#637086; opacity:1; cursor:not-allowed; }
  .wa-delivery-status a { display:inline-block; margin-top:.4rem; text-decoration:underline; text-underline-offset:3px; }





  .wa-hero { color:#fbfcf8; background-color:var(--wa-blue); background-image:linear-gradient(rgba(255,255,255,.065) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.065) 1px,transparent 1px); background-size:calc(100% / 8) 140px; padding-top:clamp(3rem,5.2vw,5rem); }
  .wa-hero-grid { display:grid; grid-template-columns:1.05fr 1fr; align-items:start; gap:clamp(2rem,5.5vw,5rem); }
  .wa-eyebrow { display:flex; align-items:center; gap:.7rem; font-size:.66rem; line-height:1.5; letter-spacing:.14em; text-transform:uppercase; font-weight:700; }
  .wa-intro>.wa-eyebrow span { width:22px; height:3px; background:#efb43f; }
  .wa h1 { color:#fff !important; font-size:clamp(3rem,5.6vw,5.1rem); font-weight:800 !important; line-height:1.04; letter-spacing:-.06em !important; margin:1.4rem 0 1.5rem; }
  .wa h1 em { font-style:normal; color:#efb43f; }
  .wa-lede { max-width:31rem; font-size:clamp(.95rem,1.2vw,1.05rem); line-height:1.85; color:#e8effa !important; }
  .wa-benefits { list-style:none; padding:0; margin-top:1.9rem !important; display:grid; gap:.8rem; font-size:.81rem; }
  .wa-benefits li { display:flex; align-items:center; gap:.9rem; }
  .wa-benefits span { color:#8edce3; font-size:.65rem; font-weight:700; }
  .wa-intro-note { font-size:.72rem; margin-top:2rem !important; color:#d7e5f7 !important; }
  .wa-scan-panel { background:var(--wa-paper); padding:clamp(1.4rem,3vw,2.5rem); border-radius:.65rem; color:var(--wa-ink); box-shadow:0 1.3rem 3rem rgba(7,26,66,.18); margin-bottom:2.8rem; }
  .wa-panel-top { display:flex; justify-content:space-between; gap:1rem; align-items:center; border-bottom:1px solid var(--wa-line); padding-bottom:1rem; margin-bottom:1.3rem; }
  .wa-panel-top .wa-eyebrow { font-size:.59rem; }
  .wa-panel-mark { font-size:.71rem; font-weight:800; color:var(--wa-blue); }
  .wa-scan-panel h2 { font-size:clamp(1.4rem,2.5vw,1.8rem); line-height:1.25; font-weight:800 !important; }
  .wa-panel-copy { font-size:.8rem; line-height:1.8; margin-top:.55rem !important; color:#42516a !important; }
  .wa form { display:grid; gap:1rem; margin-top:1.45rem; }
  .wa-field { display:grid; gap:.4rem; }
  .wa-field label { font-size:.73rem; font-weight:700; line-height:1.5; }
  .wa-field input,.wa-field select { display:block; width:100%; min-width:0; height:3.25rem; border:1px solid #a5afbc; border-radius:.3rem; padding:.7rem .85rem; background:#fff; color:var(--wa-ink); font-size:.82rem; line-height:1.4; }
  .wa-field input::placeholder { color:#637086; opacity:1; }
  .wa-field input:focus,.wa-field select:focus { outline:3px solid rgba(11,74,162,.2); border-color:var(--wa-blue); }
  .wa-field input[aria-invalid="true"] { border-color:#9e2d20; }
  .wa .wa-help { font-size:.65rem; color:#536178; line-height:1.75; }
  .wa-help a { text-decoration:underline; text-underline-offset:2px; }
  .wa-button { display:flex; align-items:center; justify-content:space-between; gap:1rem; width:100%; min-height:3.35rem; padding:.95rem 1.1rem; border:1px solid transparent; border-radius:.3rem; font-size:.79rem; line-height:1.5; font-weight:700; cursor:pointer; text-decoration:none; transition:background-color .15s; }
  .wa-button-primary { background:var(--wa-blue); color:#fff !important; }
  .wa-button-primary:hover:enabled { background:var(--wa-ink); }
  .wa-button:disabled { opacity:1; background:#e0e6eb; color:#586578 !important; border-color:#c6ced7; cursor:not-allowed; }
  .wa-button-secondary { width:auto; background:var(--wa-paper); border-color:var(--wa-blue); color:var(--wa-blue); }
  .wa-button-light { background:#efb43f; color:var(--wa-ink) !important; margin-top:1.6rem; }
  .wa-button-light:hover { background:#ffd175; }
  .wa .wa-setup { font-size:.68rem; line-height:1.7; color:#42516a; }
  .wa-scan-panel>[data-audit-availability] { margin-top:1rem; padding:.75rem .85rem; border:1px solid #c6ced7; border-radius:.3rem; background:var(--wa-muted); }
  .wa .wa-form-error { font-size:.75rem; line-height:1.7; color:#9e2d20; border-left:3px solid #9e2d20; padding:.6rem .75rem; background:#fff0ed; border-radius:.15rem; }
  .wa-sample-action { border-top:1px solid var(--wa-line); margin-top:1.25rem; padding-top:1rem; display:grid; gap:.2rem; }
  .wa-sample-action>span { font-size:.65rem; color:#536178; }
  .wa-sample-action button,.wa-text-button { border:0; background:none; padding:.35rem 0; min-height:44px; color:var(--wa-blue); font-weight:700; font-size:.75rem; text-align:left; cursor:pointer; text-decoration:underline; text-underline-offset:4px; }
  .wa-sample-action button span { margin-left:.4rem; }
  .wa-scope-line { display:flex; align-items:center; gap:2rem; border-top:1px solid rgba(255,255,255,.22); padding-block:1.3rem; }
  .wa-scope-line>span { font-size:.58rem; font-weight:700; letter-spacing:.14em; color:#d7e5f7; flex-shrink:0; }
  .wa-scope-line p { font-size:.69rem; line-height:1.7; }
  .wa-scope-line i { margin:0 .9rem; font-style:normal; color:#8edce3; }
  .wa-progress-section { display:flex; align-items:center; gap:1.5rem; padding-block:2.5rem; border-bottom:1px solid var(--wa-line); }
  .wa-progress-section h2 { font-size:1.25rem; margin-top:.35rem; }
  .wa-progress-section [role="status"] { font-size:.8rem; line-height:1.75; margin-top:.5rem; }
  .wa-progress-section .wa-text-button { margin-left:auto; flex-shrink:0; }
  .wa-progress-icon { width:2rem; height:2rem; border:3px solid #cbd8eb; border-top-color:var(--wa-blue); border-radius:50%; flex-shrink:0; animation:wa-spin 1.2s linear infinite; }
  .wa-resume { padding-block:2rem; display:flex; flex-wrap:wrap; align-items:center; gap:1.5rem; }
  .wa-resume p { flex:1 1 300px; font-size:.8rem; line-height:1.8; }
  .wa-report { padding-block:clamp(3rem,6vw,5rem); scroll-margin-top:9rem; }
  .wa-report-heading { display:flex; justify-content:space-between; align-items:end; gap:2rem; margin-bottom:1.5rem; }
  .wa-report-heading h2,.wa-method h2 { font-size:clamp(2rem,4vw,3.4rem); line-height:1.13; font-weight:800 !important; margin-top:.7rem; }
  .wa-report-context { font-size:.7rem; line-height:1.8; max-width:26rem; overflow-wrap:anywhere; white-space:pre-line; }
  .wa-demo-note { padding:1rem 1.2rem; border:1px solid #b7c9df; background:#edf3fa; margin-bottom:1.5rem !important; font-size:.75rem; line-height:1.8; }
  .wa-overview { display:grid; grid-template-columns:.9fr 1.5fr; border:1px solid var(--wa-line); border-radius:.6rem; overflow:hidden; }
  .wa-score-panel { background:var(--wa-ink); color:#fff; padding:clamp(1.5rem,3vw,2.5rem); }
  .wa-score-panel>.wa-eyebrow { color:#8edce3; }
  .wa-score { display:flex; align-items:baseline; gap:.8rem; margin:.6rem 0 .2rem !important; }
  .wa-score strong { font-size:clamp(4rem,7vw,6.5rem); font-weight:800; line-height:1.2; letter-spacing:-.07em; }
  .wa-score span { font-size:1rem; color:#b2c1d8; }
  .wa-score-panel>[data-report-score-caption] { font-weight:700; font-size:.85rem; line-height:1.6; }
  .wa-score-note { border-top:1px solid #344666; padding-top:1rem; margin-top:1.3rem !important; font-size:.65rem; line-height:1.85; color:#cbd6e7 !important; }
  .wa-categories { display:grid; grid-template-columns:1fr 1fr; background:var(--wa-line); gap:1px; }
  .wa-category { padding:1.5rem; background:var(--wa-paper); min-width:0; }
  .wa-category-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .wa-category h3 { font-size:.82rem; }
  .wa-category-score { font-size:1.3rem; font-weight:800; color:var(--wa-blue); flex-shrink:0; }
  .wa-category p { font-size:.68rem; line-height:1.9; color:#536178; margin-top:.6rem; }
  .wa-category-bar { height:3px; width:100%; background:#dce3eb; margin-top:1rem; }
  .wa-category-bar span { display:block; height:100%; background:var(--wa-blue); }
  .wa-section-heading { display:flex; align-items:end; justify-content:space-between; gap:2rem; margin:3.5rem 0 1.5rem; }
  .wa-section-heading h3 { font-size:clamp(1.45rem,2.5vw,2rem); line-height:1.3; margin-top:.5rem; font-weight:800 !important; }
  .wa-section-heading>p { font-size:.72rem; line-height:1.8; max-width:21rem; color:#536178; }
  .wa-fixes { list-style:none; padding:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border-block:1px solid var(--wa-line); }
  .wa-fix { padding:1.6rem; border-left:1px solid var(--wa-line); }
  .wa-fix:first-child { border-left:0; padding-left:0; }
  .wa-fix:last-child { padding-right:0; }
  .wa-fix-number { color:var(--wa-blue); font-size:.72rem; font-weight:800; display:block; margin-bottom:1rem; }
  .wa-fix h4 { font-size:1rem; line-height:1.5; font-weight:700 !important; }
  .wa-fix p { font-size:.72rem; line-height:1.9; margin-top:.8rem; color:#42516a; }
  .wa-fix .wa-fix-action { color:var(--wa-ink); }
  .wa-evidence { margin-top:1rem !important; padding-left:1rem; font-size:.65rem; line-height:1.8; color:#536178; overflow-wrap:anywhere; }
  .wa-evidence li+li { margin-top:.6rem; }
  .wa-evidence a { color:var(--wa-blue); text-decoration:underline; text-underline-offset:2px; }
  .wa-evidence-source { display:block; margin-top:.2rem; }
  .wa-check { border-bottom:1px solid var(--wa-line); }
  .wa-check:first-child { border-top:1px solid var(--wa-line); }
  .wa-check summary { display:flex; gap:1rem; align-items:center; padding:1.15rem .2rem; font-size:.8rem; font-weight:700; cursor:pointer; list-style:none; }
  .wa-check summary::-webkit-details-marker { display:none; }
  .wa-check summary::after { content:'+'; font-size:1.35rem; margin-left:auto; font-weight:400; }
  .wa-check[open] summary::after { content:'−'; }
