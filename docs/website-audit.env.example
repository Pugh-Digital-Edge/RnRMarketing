# Reference only; do not put real secrets in this file or in PUBLIC_* variables.
# Every feature is disabled. Only scan-work caps were approved on 2026-11-05.
AUDIT_ENABLED=false
AUDIT_LAUNCH_VERIFIED=false
AUDIT_ORIGIN=https://YOUR-APPROVED-HOSTNAME
AUDIT_DATABASE_URL=
AUDIT_SIGNING_SECRET=
AUDIT_TURNSTILE_SITE_KEY=
AUDIT_TURNSTILE_SECRET=

# Hard ceilings: $5/day and $50/month in integer USD millionths.
# Lower limits are allowed; higher values are rejected in config AND ledger.
# Approval does not cover other hosting/DB/email charges, credentials or launch.
AUDIT_DAILY_BUDGET_MICROS=5000000
AUDIT_MONTHLY_BUDGET_MICROS=50000000
# Current deterministic HTML scan has zero metered-provider/AI cost.
AUDIT_MAX_SCAN_COST_MICROS=0

# Adjustable conservative initial quotas; UTC daily accounting.
AUDIT_IP_DAILY=3
AUDIT_SESSION_DAILY=3
AUDIT_GLOBAL_DAILY=50
AUDIT_MAX_ACTIVE=2
AUDIT_MAX_QUEUED=8

# Separate report gate. No keys, custom CRM fields or sender are auto-created.
AUDIT_REPORT_ENABLED=false
AUDIT_REPORT_LAUNCH_VERIFIED=false
AUDIT_MAX_REPORT_COST_MICROS=
AUDIT_RESEND_API_KEY=
AUDIT_EMAIL_FROM=
AUDIT_HUBSPOT_TOKEN=
AUDIT_HUBSPOT_REPORT_PROPERTY=
AUDIT_HUBSPOT_CONSENT_PROPERTY=
