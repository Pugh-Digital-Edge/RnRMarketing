{
  "name": "astro-kit-les-decap",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "astro": "astro dev",
    "decap": "npx decap-server",
    "dev": "npm-run-all --parallel astro decap",
    "start": "astro dev",
    "build": "astro build && node scripts/postbuild-aeo.mjs",
    "preview": "astro preview",
    "audit:preview": "node scripts/audit-local-preview.mjs",
    "audit:preview:static": "node scripts/audit-preview.mjs",
    "audit:local": "node scripts/audit-local-preview.mjs",
    "audit:package-local": "node scripts/package-audit-local-preview.mjs",
    "audit:test:postgres": "node scripts/audit-test-postgres.mjs",
    "audit:preflight": "node scripts/audit-preflight.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "check": "astro check",
    "validate": "npm run check && npm test && npm run build",
    "seo:lock": "node scripts/seo-lock.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:due": "node scripts/seo-due.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^6.0.2",
    "@starwind-ui/astro": "^1.2.1",
    "astro": "^5.18.2",
    "astro-breadcrumbs": "^3.4.2",
    "astro-icon": "^1.1.1",
    "autoprefixer": "^10.4.20",
    "decap-server": "^3.1.2",
    "less": "^4.2.0",
    "libphonenumber-js": "^1.13.12",
    "parse5": "^8.1.0",
    "pg": "^8.23.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
